From 1f03586f892c7d12b03c5eacc1100f3247eb58d2 Mon Sep 17 00:00:00 2001
From: Somalapuram Amaranath <somalapuram@gmail.com>
Date: Mon, 14 Sep 2026 15:41:24 +0530
Subject: [PATCH] gallium/dri: CAMDBG lowered-plane import logging (debug
 instrumentation)

Change-Id: Id908b8df4385cbb8ec9e20b0046fe144678eab15
---
 src/gallium/frontends/dri/dri2.c | 10 ++++++++++
 1 file changed, 10 insertions(+)

diff --git a/src/gallium/frontends/dri/dri2.c b/src/gallium/frontends/dri/dri2.c
index e27acdbb2b7..fc7e6912a35 100644
--- a/src/gallium/frontends/dri/dri2.c
+++ b/src/gallium/frontends/dri/dri2.c
@@ -889,10 +889,20 @@ dri_create_image_from_winsys(struct dri_screen *screen,
          templ.format = map->pipe_format;
       assert(templ.format != PIPE_FORMAT_NONE);
 
+      {
+         int wh = use_lowered ? map->planes[i].buffer_index : i;
+         mesa_logi("CAMDBG lowered plane %d: format=0x%x %dx%d whandle=%d "
+                   "stride=%d offset=%d modifier=0x%llx",
+                   i, templ.format, templ.width0, templ.height0, wh,
+                   whandle[wh].stride, whandle[wh].offset,
+                   (unsigned long long)whandle[wh].modifier);
+      }
       tex = pscreen->resource_from_handle(pscreen,
                &templ, &whandle[use_lowered ? map->planes[i].buffer_index : i],
                handle_usage);
       if (!tex) {
+         mesa_logi("CAMDBG lowered resource_from_handle FAILED plane %d format=0x%x",
+                   i, templ.format);
          pipe_resource_reference(&img->texture, NULL);
          FREE(img);
          return NULL;
-- 
