From 9061e89aaf690a417a1e768241a5b3a8f46bbf30 Mon Sep 17 00:00:00 2001
From: Somalapuram Amaranath <somalapuram@gmail.com>
Date: Fri, 11 Sep 2026 12:01:01 +0530
Subject: [PATCH] egl/android: PRIME staging -- render GPU-local and tiled,
 blit at swap

Android is the only Mesa platform with no PRIME staging path, and the reason is
one line in dri2_initialize_android():

    dri2_dpy->fd_display_gpu = dri2_dpy->fd_render_gpu;   (platform_android.c)

Display GPU is hardcoded equal to render GPU, so every
fd_render_gpu != fd_display_gpu branch -- the staging that platform_x11
(loader_dri3_helper.c, linear_buffer) and platform_wayland (linear_copy) use --
is unreachable here by construction, however many GPUs the machine has.

The consequence under render offload is that dri_image_back, the gralloc
buffer, lives in the DISPLAY GPU's memory and is linear, because linear is the
only layout both devices agree on. The render GPU then draws straight into it:
every fragment write, every blend, every depth test crosses PCIe into untiled
memory owned by the other device.

Measured on an HP laptop, RTX A500 (GA107) rendering with zink on NVK, Intel
iGPU scanning out, WebGL Aquarium at 1024x1024:

    500 fish   20.0 fps
      1 fish   19.3 fps

500x less shading work for the same frame rate: not shading-bound, bound by a
fixed per-frame cost. The Intel iGPU on the identical workload does 60 fps with
zero dropped frames.

So: allocate dri_image_back_render on the render GPU with no modifier list and
no __DRI_IMAGE_USE_LINEAR, letting the driver pick its own tiled layout, hand
that to the driver as the colour buffer, and blit it into the gralloc buffer
once per eglSwapBuffers.

The blit must precede droid_window_enqueue_buffer() or the compositor is handed
a buffer the frame was never copied into.

Tiling this image is safe in a way that tiling a shared buffer is not. It is
never given to KMS or to another device, so nothing else has to understand its
layout. (Tiling the gralloc buffer itself was tried on this port and produced a
garbled display while screencap stayed perfect -- the signature of a layout the
scanout engine could not interpret.)

Gated off by default behind MESA_PRIME_STAGING, which on Android resolves to the
property vendor.mesa.prime.staging. It costs a full-surface blit per frame and
is only worth paying when the GPUs genuinely differ. Off, or if allocation
fails, dri_image_back_render stays NULL and every path falls back to the
previous behaviour.

Not addressed here: the gate should ideally derive from the devices rather than
an option, which needs platform_android to stop conflating the two GPU fds.

Co-Authored-By: Claude Opus 5 (1M context) <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01GbE6Dti9ffdUvhbzRyp3g4
Change-Id: I68ac333361db41592470cf539ac8c14cf0b6961f
---
 src/egl/drivers/dri2/egl_dri2.h         |  19 ++++
 src/egl/drivers/dri2/platform_android.c | 115 +++++++++++++++++++++++-
 2 files changed, 133 insertions(+), 1 deletion(-)

diff --git a/src/egl/drivers/dri2/egl_dri2.h b/src/egl/drivers/dri2/egl_dri2.h
index 4ee70dfae18..1d3fcaaaf61 100644
--- a/src/egl/drivers/dri2/egl_dri2.h
+++ b/src/egl/drivers/dri2/egl_dri2.h
@@ -373,6 +373,25 @@ struct dri2_egl_surface {
    struct dri_image *dri_image_back;
    struct dri_image *dri_image_front;
 
+   /* PRIME staging (Android).
+    *
+    * When the rendering GPU is not the GPU that scans out, dri_image_back --
+    * the gralloc buffer -- lives in the DISPLAY GPU's memory and is linear,
+    * because that is the only thing both devices can agree on. Rendering
+    * straight into it means every fragment write crosses PCIe into untiled
+    * memory belonging to the other device.
+    *
+    * dri_image_back_render is a render-GPU-local, driver-tiled target used as
+    * the actual colour buffer; it is blitted into dri_image_back once per
+    * eglSwapBuffers. This is what platform_x11 (loader_dri3_helper.c
+    * linear_buffer) and platform_wayland (linear_copy) already do; the Android
+    * platform never had it because it hardcodes
+    * fd_display_gpu = fd_render_gpu.
+    *
+    * NULL when staging is off, which is the single-GPU case and the default.
+    */
+   struct dri_image *dri_image_back_render;
+
    /* Used to record all the buffers created by ANativeWindow and their ages.
     * Allocate number of color_buffers based on query to android bufferqueue
     * and save color_buffers_count.
diff --git a/src/egl/drivers/dri2/platform_android.c b/src/egl/drivers/dri2/platform_android.c
index 7db9f6bccb6..ecef165171e 100644
--- a/src/egl/drivers/dri2/platform_android.c
+++ b/src/egl/drivers/dri2/platform_android.c
@@ -205,6 +205,10 @@ droid_window_enqueue_buffer(_EGLDisplay *disp,
       dri2_destroy_image(dri2_surf->dri_image_back);
       dri2_surf->dri_image_back = NULL;
    }
+   if (dri2_surf->dri_image_back_render) {
+      dri2_destroy_image(dri2_surf->dri_image_back_render);
+      dri2_surf->dri_image_back_render = NULL;
+   }
 
    return EGL_TRUE;
 }
@@ -406,6 +410,11 @@ droid_destroy_surface(_EGLDisplay *disp, _EGLSurface *surf)
       dri2_surf->dri_image_back = NULL;
    }
 
+   if (dri2_surf->dri_image_back_render) {
+      dri2_destroy_image(dri2_surf->dri_image_back_render);
+      dri2_surf->dri_image_back_render = NULL;
+   }
+
    if (dri2_surf->dri_image_front) {
       _eglLog(_EGL_DEBUG, "%s : %d : destroy dri_image_front", __func__,
               __LINE__);
@@ -493,6 +502,32 @@ get_front_bo(struct dri2_egl_surface *dri2_surf, unsigned int format)
    return 0;
 }
 
+
+/* PRIME staging: render into a GPU-local tiled buffer and blit to the gralloc
+ * buffer at swap, instead of rendering directly into the other GPU's memory.
+ *
+ * Off by default because it costs a full-surface blit per frame, which is only
+ * worth paying when the render and scanout GPUs genuinely differ. Read through
+ * Mesa's option mechanism, so on Android this is the property
+ * vendor.mesa.prime.staging (os_misc.c lowercases the name, maps _ to . and
+ * prefixes "mesa.").
+ *
+ * It cannot be decided from fd_render_gpu != fd_display_gpu the way the X11 and
+ * Wayland platforms decide it: dri2_initialize_android() assigns
+ * fd_display_gpu = fd_render_gpu unconditionally, so that test is always false
+ * here no matter how many GPUs the machine has.
+ */
+static bool
+droid_prime_staging_enabled(void)
+{
+   static int enabled = -1;
+
+   if (enabled < 0)
+      enabled = debug_get_bool_option("MESA_PRIME_STAGING", false) ? 1 : 0;
+
+   return enabled == 1;
+}
+
 static int
 get_back_bo(struct dri2_egl_surface *dri2_surf)
 {
@@ -516,6 +551,45 @@ get_back_bo(struct dri2_egl_surface *dri2_surf)
 
       handle_in_fence_fd(dri2_surf, dri2_surf->dri_image_back);
 
+      /* Allocate the render-GPU-local colour buffer this frame will actually
+       * be drawn into. No modifier list and no __DRI_IMAGE_USE_LINEAR, so the
+       * driver picks its own optimal (tiled) layout -- the whole point.
+       *
+       * Safe to tile: unlike the gralloc buffer this image is never handed to
+       * KMS or to another device, so nothing else has to understand its
+       * layout. Tiling a SHARED buffer is what produces a garbled screen.
+       */
+      if (droid_prime_staging_enabled() && !dri2_surf->dri_image_back_render) {
+         struct dri2_egl_display *dri2_dpy = dri2_egl_display(disp);
+         struct u_gralloc_buffer_basic_info buf_info;
+         struct u_gralloc_buffer_handle gr_handle = {
+            .handle = dri2_surf->buffer->handle,
+            .hal_format = dri2_surf->buffer->format,
+            .pixel_stride = dri2_surf->buffer->stride,
+         };
+
+         if (u_gralloc_get_buffer_basic_info(dri2_dpy->gralloc, &gr_handle,
+                                             &buf_info) == 0) {
+            enum pipe_format pf =
+               loader_fourcc_to_pipe_format(buf_info.drm_fourcc);
+
+            if (pf != PIPE_FORMAT_NONE) {
+               dri2_surf->dri_image_back_render = dri_create_image(
+                  dri2_dpy->dri_screen_render_gpu, dri2_surf->base.Width,
+                  dri2_surf->base.Height, pf, NULL, 0,
+                  __DRI_IMAGE_USE_SHARE | __DRI_IMAGE_USE_BACKBUFFER, NULL);
+            }
+
+            /* Not fatal: fall back to rendering into the gralloc buffer
+             * directly, which is exactly the previous behaviour. */
+            if (!dri2_surf->dri_image_back_render)
+               _eglLog(_EGL_WARNING,
+                       "PRIME staging: could not allocate a render-local "
+                       "target (fourcc 0x%x); rendering directly",
+                       buf_info.drm_fourcc);
+         }
+      }
+
    } else if (dri2_surf->base.Type == EGL_PBUFFER_BIT) {
       /* The EGL 1.5 spec states that pbuffers are single-buffered.
        * Specifically, the spec states that they have a back buffer but no front
@@ -588,7 +662,14 @@ droid_image_get_buffers(struct dri_drawable *driDrawable, unsigned int format,
       if (get_back_bo(dri2_surf) < 0)
          return 0;
 
-      if (dri2_surf->dri_image_back) {
+      /* With PRIME staging the driver draws into the render-GPU-local target,
+       * not the gralloc buffer; droid_swap_buffers() blits one into the other.
+       * dri_image_back_render is NULL whenever staging is off or allocation
+       * failed, so this falls back to the original behaviour by itself. */
+      if (dri2_surf->dri_image_back_render) {
+         images->back = dri2_surf->dri_image_back_render;
+         images->image_mask |= __DRI_IMAGE_BUFFER_BACK;
+      } else if (dri2_surf->dri_image_back) {
          images->back = dri2_surf->dri_image_back;
          images->image_mask |= __DRI_IMAGE_BUFFER_BACK;
       }
@@ -654,6 +735,34 @@ droid_swap_buffers(_EGLDisplay *disp, _EGLSurface *draw)
        * a callback to ANativeWindow_dequeueBuffer, in which case
        * dri2_surf->buffer remains null.
        */
+      /* PRIME staging: resolve the render-GPU-local target into the gralloc
+       * buffer. One full-surface blit per frame, which is the entire point --
+       * it replaces every fragment write crossing PCIe into the other GPU's
+       * untiled memory with a single sequential copy the driver can optimise.
+       *
+       * Must happen BEFORE droid_window_enqueue_buffer(), or the compositor is
+       * handed a buffer the frame was never copied into.
+       */
+      if (dri2_surf->dri_image_back_render && dri2_surf->dri_image_back) {
+         _EGLContext *ctx = _eglGetCurrentContext();
+         struct dri2_egl_context *dri2_ctx = dri2_egl_context(ctx);
+
+         if (dri2_ctx) {
+            dri2_blit_image(dri2_ctx->dri_context, dri2_surf->dri_image_back,
+                            dri2_surf->dri_image_back_render, 0, 0,
+                            dri2_surf->base.Width, dri2_surf->base.Height, 0, 0,
+                            dri2_surf->base.Width, dri2_surf->base.Height, 0);
+            dri_flush_drawable(dri2_surf->dri_drawable);
+         } else {
+            /* No current context means no way to issue the blit, and the
+             * gralloc buffer would go out stale. Loud, because a silently
+             * wrong frame is worse than a slow one. */
+            _eglLog(_EGL_WARNING,
+                    "PRIME staging: no current context at swap; frame not "
+                    "resolved");
+         }
+      }
+
       if (dri2_surf->buffer)
          droid_window_enqueue_buffer(disp, dri2_surf);
 
@@ -937,6 +1046,10 @@ droid_display_shared_buffer(struct dri_drawable *driDrawable, int fence_fd,
          dri2_destroy_image(dri2_surf->dri_image_back);
          dri2_surf->dri_image_back = NULL;
       }
+      if (dri2_surf->dri_image_back_render) {
+         dri2_destroy_image(dri2_surf->dri_image_back_render);
+         dri2_surf->dri_image_back_render = NULL;
+      }
 
       dri_invalidate_drawable(dri2_surf->dri_drawable);
       return;
