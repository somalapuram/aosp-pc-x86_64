From 2253de11b6fb63a9bd1d9a3a8a47995ac9086be7 Mon Sep 17 00:00:00 2001
From: Somalapuram Amaranath <somalapuram@gmail.com>
Date: Tue, 8 Sep 2026 16:32:42 +0530
Subject: [PATCH] minigbm: compile the AMD backend into the pc platform

backend_amdgpu is the only backend that matches the "amdgpu" kernel driver
name in drv_backend_list, so without DRV_AMDGPU the gralloc allocator
exits at init on any Radeon and SurfaceFlinger crash-loops behind it.

NVIDIA needs nothing added. backend_nouveau is already in that list
unconditionally, built from INIT_DUMB_DRIVER(nouveau) -- linear dumb
buffers, no tiling, but it allocates and scans out. Which also means
DRV_PC_FORCE_LINEAR costs nothing on that path.

libdrm_amdgpu is added to the gralloc shared libs because amdgpu.c
includes <amdgpu.h> and <amdgpu_drm.h>. It is harmless on a machine with
no Radeon in it: a shared library that never gets asked for a device.

Co-Authored-By: Claude Opus 5 (1M context) <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01T25srwc2c161osFbwoP4Di
Change-Id: I5cbe02dfa6d31726f713a42b812734fcbcc4df1d
---
 Android.bp | 14 ++++++++++++++
 1 file changed, 14 insertions(+)

diff --git a/Android.bp b/Android.bp
index 1929cff..0da354e 100644
--- a/Android.bp
+++ b/Android.bp
@@ -82,6 +82,16 @@ intel_cflags = [
 pc_cflags = intel_cflags + [
     "-DHAS_DMABUF_SYSTEM_HEAP",
     "-DDRV_PC_FORCE_LINEAR",
+    // AMD. backend_amdgpu is the real tiling-aware backend and is the only way
+    // amdgpu allocates at all: drv_backend_list matches on the kernel driver
+    // name, "amdgpu" matches nothing else, and without this the gralloc
+    // allocator exits at init on any Radeon.
+    //
+    // NVIDIA needs nothing here. backend_nouveau is already in the dispatch
+    // list unconditionally, built from INIT_DUMB_DRIVER(nouveau) -- linear
+    // dumb buffers, no tiling, but it allocates and scans out. Which is also
+    // why DRV_PC_FORCE_LINEAR above costs nothing on that path.
+    "-DDRV_AMDGPU",
 ]
 
 meson_cflags = ["-DDRV_MESON"]
@@ -154,6 +164,10 @@ cc_defaults {
         "libcutils",
         "libdmabufheap",
         "libdrm",
+        // amdgpu.c includes <amdgpu.h> and <amdgpu_drm.h>. Harmless on a
+        // machine with no Radeon in it -- it is a shared library that simply
+        // never gets asked for a device.
+        "libdrm_amdgpu",
         "libgralloctypes",
         "liblog",
         "libnativewindow",
