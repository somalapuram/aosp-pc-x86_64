From a91b59e725fe3459f3a98e181baab1b845a09976 Mon Sep 17 00:00:00 2001
From: Somalapuram Amaranath <somalapuram@gmail.com>
Date: Wed, 9 Sep 2026 16:26:32 +0530
Subject: [PATCH] minigbm: log which DRM node was tried and why it was refused

When gralloc comes up with no backend, the most useful fact is whether the card
node was REFUSED or never reached -- and init_try_node() threw it away: a failed
open() was a silent `return NULL`, indistinguishable from the loop never getting
there.

That matters because the dumb backend can only allocate on a card node.
CREATE_DUMB is -EACCES on a render node by construction, so the guard added in
0005 declines it and the loop is meant to walk on to card0. On the AMD
workstation it declines 27 times -- in the allocator HAL service among others --
and every allocation then fails:

    GraphicBufferAllocator: Failed to allocate (1920x1080) format 1 usage b00: 5
    F HWUI: drawRenderNode called on a context with no surface!

crash-looping the launcher and SystemUI while SurfaceFlinger runs radeonsi
perfectly well. No SELinux denials were logged against hal_graphics_allocator,
so policy is not obviously the answer, and without the node path there is
nothing left to reason from.

Each attempt now says what it was and how it ended, and the decline message
names the kernel driver and decodes the errno -- "errno 13" alone does not
distinguish a render-node refusal from a DAC or SELinux one.

Co-Authored-By: Claude Opus 5 (1M context) <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01RcW789BaWxArn8W86dZD6D
Change-Id: I5c6a2bc6f8f049af9337d43f60ba4132d414d77a
---
 cros_gralloc/cros_gralloc_driver.cc | 29 ++++++++++++++++++++++++++---
 dumb_driver.c                       | 28 +++++++++++++++++++++++++++-
 2 files changed, 53 insertions(+), 4 deletions(-)

diff --git a/cros_gralloc/cros_gralloc_driver.cc b/cros_gralloc/cros_gralloc_driver.cc
index 389fb5f..38462c3 100644
--- a/cros_gralloc/cros_gralloc_driver.cc
+++ b/cros_gralloc/cros_gralloc_driver.cc
@@ -104,10 +104,23 @@ static struct driver *init_try_node(int idx, char const *str)
 		return NULL;
 
 	fd = open(node, O_RDWR, 0);
-	free(node);
 
-	if (fd < 0)
+	/*
+	 * Say which node was tried and why it was refused.
+	 *
+	 * A silent `return NULL` here hides the single most useful fact when
+	 * gralloc comes up with no backend: whether the card node was REFUSED or
+	 * never reached. The dumb backend can only allocate on a card node --
+	 * CREATE_DUMB is -EACCES on a render node by construction -- so the whole
+	 * question is what happened when this loop got to card0, and open() failing
+	 * with EACCES looks exactly like open() never being called.
+	 */
+	if (fd < 0) {
+		ALOGI("gralloc: %s -> open failed: %s", node, strerror(errno));
+		free(node);
 		return NULL;
+	}
+	ALOGI("gralloc: %s -> opened fd %d", node, fd);
 
 	/*
 	 * Never hold DRM master.
@@ -131,9 +144,19 @@ static struct driver *init_try_node(int idx, char const *str)
 	drmDropMaster(fd);
 
 	drv = drv_create(fd, NULL);
-	if (!drv)
+	if (!drv) {
+		drmVersionPtr v = drmGetVersion(fd);
+		ALOGI("gralloc: %s -> no usable backend (kernel driver '%s')", node,
+		      v && v->name ? v->name : "?");
+		if (v)
+			drmFreeVersion(v);
 		close(fd);
+	} else {
+		ALOGI("gralloc: %s -> ACCEPTED, backend '%s'", node,
+		      drv_get_name(drv) ? drv_get_name(drv) : "?");
+	}
 
+	free(node);
 	return drv;
 }
 
diff --git a/dumb_driver.c b/dumb_driver.c
index 9809538..c2d8c15 100644
--- a/dumb_driver.c
+++ b/dumb_driver.c
@@ -32,6 +32,28 @@ static const uint32_t scanout_render_formats[] = { DRM_FORMAT_ARGB8888, DRM_FORM
 						   DRM_FORMAT_ABGR8888, DRM_FORMAT_XBGR8888,
 						   DRM_FORMAT_BGR888,	DRM_FORMAT_RGB565 };
 
+/* Render-only, not scanout: FP16 is what SurfaceFlinger and HWUI ask for as soon
+ * as the display is treated as wide-gamut, and a display pipe cannot scan it out.
+ *
+ * Leaving it out is not a missing feature, it is a crash. cros_gralloc refuses
+ * the descriptor --
+ *
+ *     Failed to convert descriptor. Unsupported format 0x3c
+ *     pixel format:RGBA_FP16, drm format:DRM_FOURCC_AB4H, usage:GPU_TEXTURE
+ *
+ * -- so dequeueBuffer returns -22, the Surface never gets a buffer, and HWUI
+ * aborts the process:
+ *
+ *     F HWUI: drawRenderNode called on a context with no surface!
+ *
+ * which on the AMD workstation crash-looped the launcher and SystemUI while
+ * SurfaceFlinger itself was happily running radeonsi. i915.c has carried exactly
+ * this one-element render_formats list all along; the dumb backend needs it for
+ * the same reason. Dumb buffers are linear and drv_dumb_bo_create derives the
+ * stride from the format, so 64bpp needs no special handling.
+ */
+static const uint32_t render_formats[] = { DRM_FORMAT_ABGR16161616F };
+
 static const uint32_t texture_only_formats[] = { DRM_FORMAT_R8, DRM_FORMAT_NV12, DRM_FORMAT_NV21,
 						 DRM_FORMAT_YVU420, DRM_FORMAT_YVU420_ANDROID };
 
@@ -70,7 +92,8 @@ static int dumb_driver_probe_create(struct driver *drv)
 
 	ret = drmIoctl(drv_get_fd(drv), DRM_IOCTL_MODE_CREATE_DUMB, &create_dumb);
 	if (ret) {
-		drv_logi("dumb: node rejects CREATE_DUMB (errno %d), declining it\n", errno);
+		drv_logi("dumb: kernel driver '%s' rejects CREATE_DUMB (errno %d: %s), declining it\n",
+			 drv_get_name(drv) ? drv_get_name(drv) : "?", errno, strerror(errno));
 		return -errno;
 	}
 
@@ -88,6 +111,9 @@ static int dumb_driver_init(struct driver *drv)
 	drv_add_combinations(drv, scanout_render_formats, ARRAY_SIZE(scanout_render_formats),
 			     &LINEAR_METADATA, BO_USE_RENDER_MASK | BO_USE_SCANOUT);
 
+	drv_add_combinations(drv, render_formats, ARRAY_SIZE(render_formats), &LINEAR_METADATA,
+			     BO_USE_RENDER_MASK);
+
 	drv_add_combinations(drv, texture_only_formats, ARRAY_SIZE(texture_only_formats),
 			     &LINEAR_METADATA, BO_USE_TEXTURE_MASK);
 
