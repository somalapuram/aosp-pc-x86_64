+++ b/drm/DrmAtomicStateManager.cpp
@@ -139,7 +139,9 @@ std::optional<AtomicCommitResult> DrmAtomicStateManager::CommitFrame(
                                    atomic_request->property_set.get(),
                                    flags | DRM_MODE_ATOMIC_TEST_ONLY, drm);
 
-    ALOGV_IF(err != 0, "Test-only seamless=%d ret=%d errno=%d strerror=%s\n",
+    /* DIAGNOSTIC (pc_x86_64): was ALOGV, i.e. compiled out of a release
+     * build, so a failing plane test left no trace at all. */
+    ALOGE_IF(err != 0, "TEST-COMMIT-FAIL seamless=%d ret=%d errno=%d strerror=%s\n",
              args.seamless, err, errno,
              strerror_r(errno, err_buf, error_buf_max_size));
     return err == 0 ? std::make_optional<AtomicCommitResult>() : std::nullopt;
diff --git a/drm/DrmFbImporter.cpp b/drm/DrmFbImporter.cpp
index d8f5e1b..26fc382 100644
--- a/drm/DrmFbImporter.cpp
+++ b/drm/DrmFbImporter.cpp
@@ -26,6 +26,9 @@
 #include <xf86drmMode.h>
 
 #include <cinttypes>
+#include <mutex>
+#include <set>
+#include <utility>
 #include <system_error>
 
 #include "bufferinfo/BufferInfo.h"
@@ -65,6 +68,23 @@ auto DrmFbIdHandle::CreateInstance(BufferInfo *bo, GemHandle first_gem_handle,
   auto has_modifiers = bo->modifiers[0] != DRM_FORMAT_MOD_NONE &&
                        bo->modifiers[0] != DRM_FORMAT_MOD_INVALID;
 
+  /* DIAGNOSTIC (pc_x86_64): this is the only place the buffer's modifier
+   * decides between drmModeAddFB2() and drmModeAddFB2WithModifiers(). Enabling
+   * tiled allocation produced a garbled panel while screencap stayed perfect,
+   * and nothing logged why. Print each distinct format/modifier pair once. */
+  {
+    static std::mutex seen_lock;
+    static std::set<std::pair<uint32_t, uint64_t>> seen;
+    const std::lock_guard<std::mutex> lock(seen_lock);
+    if (seen.size() < 32 &&
+        seen.emplace(bo->format, bo->modifiers[0]).second) {
+      ALOGE("FB-IMPORT: format=0x%08x modifier=0x%" PRIx64
+            " has_modifiers=%d pitch=%d w=%d h=%d",
+            bo->format, bo->modifiers[0], static_cast<int>(has_modifiers),
+            bo->pitches[0], bo->width, bo->height);
+    }
+  }
+
   if (!drm.HasAddFb2ModifiersSupport() && has_modifiers) {
     ALOGE("No ADDFB2 with modifier support. Can't import modifier %" PRIu64,
           bo->modifiers[0]);
