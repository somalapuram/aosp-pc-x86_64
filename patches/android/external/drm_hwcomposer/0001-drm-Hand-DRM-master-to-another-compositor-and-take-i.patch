From e1f358c464197a0573e4a5b561d2d579c056a6cd Mon Sep 17 00:00:00 2001
From: Somalapuram Amaranath <somalapuram@gmail.com>
Date: Wed, 4 Nov 2026 08:18:18 +0530
Subject: [PATCH] drm: Hand DRM master to another compositor and take it back

pc_x86_64 runs Ubuntu alongside Android on the same kernel, and Ubuntu's
GNOME needs the screen while it is in front. drm_hwcomposer takes
master once at init and never gives it up, except for the init-time
ro.vendor.hwc.drop_drm_master.

Add a runtime hand-off driven by vendor.hwc.master. Setting it to
"ubuntu" makes each device drop master. While master is released,
CommitFrame reports success without committing, because every atomic
commit, test-only ones included, would fail with EACCES, and
SurfaceFlinger should carry on undisturbed. VSync keeps working, since
drmWaitVBlank does not need master.

Setting it back to "android" retakes master and clears every
non-primary plane, because the other compositor may have left planes on
(GNOME's cursor plane, for one) that this process never tracked. The
primary is left alone: amdgpu rejects a commit that leaves an active
CRTC without one, and the next frame replaces it. Each display is then
asked for a new frame.

Tested on an HP ZBook (amdgpu): release and retake both log success and
clear 6 planes, the composer and SurfaceFlinger keep their PIDs, and
GNOME Shell takes the panel with atomic modesetting in between.

Change-Id: I881a557b659323b5c798040579d22ef7224da4da
---
 drm/DrmAtomicStateManager.cpp |  7 ++++
 drm/DrmDevice.cpp             | 74 +++++++++++++++++++++++++++++++++++
 drm/DrmDevice.h               | 11 ++++++
 drm/DrmHwc.h                  |  4 ++
 drm/ResourceManager.cpp       | 43 ++++++++++++++++++++
 drm/ResourceManager.h         |  3 ++
 6 files changed, 142 insertions(+)

diff --git a/drm/DrmAtomicStateManager.cpp b/drm/DrmAtomicStateManager.cpp
index 99d646f..8dfd313 100644
--- a/drm/DrmAtomicStateManager.cpp
+++ b/drm/DrmAtomicStateManager.cpp
@@ -110,6 +110,13 @@ std::optional<AtomicCommitResult> DrmAtomicStateManager::CommitFrame(
     return AtomicCommitResult{};
   }
 
+  if (pipe_->device->IsMasterReleased()) {
+    /* Another compositor has the screen (DrmDevice::ReleaseMaster). Without
+     * master every commit, test-only ones included, fails with EACCES; tell
+     * the frontend it succeeded so SurfaceFlinger carries on undisturbed. */
+    return AtomicCommitResult{};
+  }
+
   if (!committed_frame_state_.crtc_active_state) {
     // Force args.power_mode if the display is not active and there are other
     // things to commit.
diff --git a/drm/DrmDevice.cpp b/drm/DrmDevice.cpp
index 7816e02..ed0f48d 100644
--- a/drm/DrmDevice.cpp
+++ b/drm/DrmDevice.cpp
@@ -185,6 +185,80 @@ auto DrmDevice::Init(const char *path) -> int {
 }
 // NOLINTEND(readability-function-cognitive-complexity)
 
+auto DrmDevice::ReleaseMaster() -> void {
+  master_released_ = true;
+  if (drmDropMaster(*GetFd()) != 0) {
+    ALOGE("Failed to drop DRM master on %s: %s", GetName().c_str(),
+          strerror(errno));
+    return;
+  }
+  ALOGI("Released DRM master on %s", GetName().c_str());
+}
+
+// Take the screen back after another compositor had it. That compositor may
+// have left planes on (GNOME's cursor plane, for one) that this process never
+// tracked, so they would stay on screen over Android: switch off every
+// non-primary plane first. The primary is left alone -- amdgpu rejects a commit
+// that leaves an active CRTC without one -- and the next frame replaces it.
+auto DrmDevice::RetakeMaster() -> bool {
+  if (drmSetMaster(*GetFd()) != 0 || drmIsMaster(*GetFd()) == 0) {
+    ALOGE("Failed to retake DRM master on %s: %s", GetName().c_str(),
+          strerror(errno));
+    return false;
+  }
+
+  auto *res = drmModeGetPlaneResources(*GetFd());
+  auto *req = drmModeAtomicAlloc();
+  int disabled = 0;
+  for (uint32_t i = 0; res != nullptr && req != nullptr && i < res->count_planes;
+       i++) {
+    // NOLINTNEXTLINE(cppcoreguidelines-pro-bounds-pointer-arithmetic)
+    const uint32_t plane_id = res->planes[i];
+    auto *props = drmModeObjectGetProperties(*GetFd(), plane_id,
+                                             DRM_MODE_OBJECT_PLANE);
+    if (props == nullptr)
+      continue;
+    bool primary = false;
+    uint32_t fb_prop = 0;
+    uint32_t crtc_prop = 0;
+    for (uint32_t j = 0; j < props->count_props; j++) {
+      // NOLINTNEXTLINE(cppcoreguidelines-pro-bounds-pointer-arithmetic)
+      auto *prop = drmModeGetProperty(*GetFd(), props->props[j]);
+      if (prop == nullptr)
+        continue;
+      const std::string name = prop->name;
+      if (name == "type")
+        // NOLINTNEXTLINE(cppcoreguidelines-pro-bounds-pointer-arithmetic)
+        primary = props->prop_values[j] == DRM_PLANE_TYPE_PRIMARY;
+      else if (name == "FB_ID")
+        fb_prop = prop->prop_id;
+      else if (name == "CRTC_ID")
+        crtc_prop = prop->prop_id;
+      drmModeFreeProperty(prop);
+    }
+    drmModeFreeObjectProperties(props);
+    if (!primary && fb_prop != 0 && crtc_prop != 0) {
+      drmModeAtomicAddProperty(req, plane_id, fb_prop, 0);
+      drmModeAtomicAddProperty(req, plane_id, crtc_prop, 0);
+      disabled++;
+    }
+  }
+  if (req != nullptr && disabled > 0 &&
+      drmModeAtomicCommit(*GetFd(), req, DRM_MODE_ATOMIC_ALLOW_MODESET,
+                          nullptr) != 0)
+    ALOGW("Clearing %d leftover planes on %s failed: %s", disabled,
+          GetName().c_str(), strerror(errno));
+  if (req != nullptr)
+    drmModeAtomicFree(req);
+  if (res != nullptr)
+    drmModeFreePlaneResources(res);
+
+  master_released_ = false;
+  ALOGI("Retook DRM master on %s, cleared %d planes", GetName().c_str(),
+        disabled);
+  return true;
+}
+
 auto DrmDevice::RegisterUserPropertyBlob(const void *data, size_t length) const
     -> DrmModeUserPropertyBlobUnique {
   struct drm_mode_create_blob create_blob {};
