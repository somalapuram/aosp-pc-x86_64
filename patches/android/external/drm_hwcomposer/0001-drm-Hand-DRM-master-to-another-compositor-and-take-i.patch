index 5e60a2d..3aee275 100644
--- a/drm/DrmDevice.h
+++ b/drm/DrmDevice.h
@@ -16,6 +16,7 @@
 
 #pragma once
 
+#include <atomic>
 #include <cstdint>
 #include <map>
 #include <optional>
@@ -36,6 +37,7 @@ class DrmProperty;
 class ResourceManager;
 
 class DrmDevice {
+  std::atomic<bool> master_released_{false};
   friend class FakeDrmDevice;
   friend class FakeCompositorDrmDevice;
 
@@ -102,6 +104,15 @@ class DrmDevice {
     return cap_cursor_size_;
   }
 
+  // Runtime hand-off of DRM master to another compositor on the same
+  // machine (Ubuntu's GNOME, see ResourceManager::WatchMasterProperty).
+  // While released, every commit for this device is a no-op success.
+  auto ReleaseMaster() -> void;
+  auto RetakeMaster() -> bool;
+  auto IsMasterReleased() const -> bool {
+    return master_released_.load();
+  }
+
   auto RefreshConnectors() -> std::vector<std::unique_ptr<DrmConnector>>;
   auto ResetConnectorsAndCrtcs() -> void;
 
diff --git a/drm/DrmHwc.h b/drm/DrmHwc.h
index c2db597..442e04b 100644
--- a/drm/DrmHwc.h
+++ b/drm/DrmHwc.h
@@ -85,6 +85,10 @@ class DrmHwc : public PipelineToFrontendBindingInterface, public StatsProvider {
   bool BindDisplay(std::shared_ptr<DrmDisplayPipeline> pipeline) override;
   bool UnbindDisplay(std::shared_ptr<DrmDisplayPipeline> pipeline) override;
   void FinalizeDisplayBinding() override;
+  void RefreshAllDisplays() override {
+    for (auto &d : displays_)
+      SendRefreshEventToClient(d.first);
+  }
 
   // Notify Display Link Status
   void NotifyDisplayLinkStatus(
diff --git a/drm/ResourceManager.cpp b/drm/ResourceManager.cpp
index defec12..ca71faf 100644
--- a/drm/ResourceManager.cpp
+++ b/drm/ResourceManager.cpp
@@ -18,9 +18,11 @@
 
 #include <android-base/strings.h>
 #include <sys/stat.h>
+#include <sys/system_properties.h>
 
 #include <ctime>
 #include <sstream>
+#include <thread>
 
 #include "backend/BackendManager.h"
 #include "bufferinfo/BufferInfoGetter.h"
@@ -116,9 +118,50 @@ void ResourceManager::Init() {
 
   UpdateFrontendDisplays();
 
+  std::thread([this] { WatchMasterProperty(); }).detach();
+
   initialized_ = true;
 }
 
+// Hand the screen to Ubuntu and back, on vendor.hwc.master = "ubuntu" |
+// "android". Set by the seat broker (doc/10-ubuntu-alongside-android.md, step
+// 3 M3); for testing, by `setprop` from a root shell. Runs for the life of the
+// process; a change to the value it last acted on is all that wakes it.
+void ResourceManager::WatchMasterProperty() {
+  std::string acted = "android";
+  uint32_t serial = 0;
+  for (;;) {
+    const prop_info *pi = __system_property_find("vendor.hwc.master");
+    if (pi == nullptr) {
+      /* Not set yet: wait for any property change, then look again. */
+      __system_property_wait(nullptr, serial, &serial, nullptr);
+      continue;
+    }
+    std::string value;
+    __system_property_read_callback(
+        pi,
+        [](void *cookie, const char *, const char *v, uint32_t) {
+          *static_cast<std::string *>(cookie) = v;
+        },
+        &value);
+    if (value != acted && (value == "ubuntu" || value == "android")) {
+      const std::unique_lock lock(GetMainLock());
+      bool retook = false;
+      for (auto &drm : drms_) {
+        if (value == "ubuntu")
+          drm->ReleaseMaster();
+        else
+          retook |= drm->RetakeMaster();
+      }
+      if (retook)
+        frontend_interface_->RefreshAllDisplays();
+      acted = value;
+    }
+    uint32_t prop_serial = __system_property_serial(pi);
+    __system_property_wait(pi, prop_serial, &prop_serial, nullptr);
+  }
+}
+
 void ResourceManager::DeInit() {
   if (!initialized_) {
     ALOGE("Not initialized");
diff --git a/drm/ResourceManager.h b/drm/ResourceManager.h
index 03b10d8..9c9916b 100644
--- a/drm/ResourceManager.h
+++ b/drm/ResourceManager.h
@@ -41,6 +41,8 @@ class PipelineToFrontendBindingInterface {
       std::shared_ptr<DrmDisplayPipeline> pipeline) = 0;
   virtual void NotifyHdcpTermination(
       std::shared_ptr<DrmDisplayPipeline> pipeline) = 0;
+  // After DRM master comes back: every display needs a new frame.
+  virtual void RefreshAllDisplays() {}
 };
 
 class ResourceManager {
@@ -88,6 +90,7 @@ class ResourceManager {
   void DetachStalePipelines(
       const std::vector<std::unique_ptr<DrmConnector>> &stale_connectors);
   void DetachAllFrontendDisplays();
+  void WatchMasterProperty();
 
   std::vector<std::unique_ptr<DrmDevice>> drms_;
   std::set<std::string> displays_;
