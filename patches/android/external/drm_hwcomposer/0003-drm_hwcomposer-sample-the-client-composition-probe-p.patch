From e7cb47d27f1e9a1d12143c522e5495c1032ad8ed Mon Sep 17 00:00:00 2001
From: Somalapuram Amaranath <somalapuram@gmail.com>
Date: Fri, 11 Sep 2026 10:43:31 +0530
Subject: [PATCH 3/3] drm_hwcomposer: sample the client-composition probe
 periodically, not once

The first probe throttled per reason BIT, so one bufferless container layer
produced identical output to every-layer-is-broken. The second logged every
layer but only for 20 frames, and 20 frames elapsed in 1.25 SECONDS, entirely
inside the boot animation. Measured there:

    CLIENT-REASON f=0 z=0/1 why=0x0 sf_type=2 fb=1 disp=1920x1200 src=1920x1200
    CLIENT-REASON f=0 SUMMARY client_start=0 client_size=0 of 1

why=0x0, sf_type=2 (DEVICE), client_size=0: device composition WORKS. The
all-client behaviour belongs to the multi-layer desktop, which that window
never reached.

Now the first 20 frames plus every 300th for the life of the process, so the
steady state is sampled at roughly one burst per 5 seconds.

Reading it needs the ON-DISK copy, not logcat. The main ring buffer on this
device is 256 KiB and evicts the composer's startup logging within seconds:
every live logcat -d came back empty while /data/local/tmp/bootlog.txt, which
pc_logcat_file.sh streams, held all 42 lines. persist.logd.size=16M was set and
logd ignored it, still reporting 256 KiB.

FB-IMPORT also recorded all four distinct pairs, every one modifier 0x0 on this
linear build, so the modifier path is NOT broken and the earlier explanation for
the tiling corruption is withdrawn:

    XR24 1920x1200 pitch 7680     XB24 1920x1200 pitch 7680
    AB24 2560x1600 pitch 10240    AR24 256x256 pitch 1024

The 2560x1600 client target on a 1920x1200 panel is worth a look on its own.

Co-Authored-By: Claude Opus 5 (1M context) <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01GbE6Dti9ffdUvhbzRyp3g4
Change-Id: Ifd2c9cedf403bd948e25de9e24f3b32b76cd5387
---
 compositor/GenericCompositionPlanner.cpp | 92 ++++++++++++++++--------
 compositor/GenericCompositionPlanner.h   |  3 +
 2 files changed, 65 insertions(+), 30 deletions(-)

diff --git a/compositor/GenericCompositionPlanner.cpp b/compositor/GenericCompositionPlanner.cpp
index 40a89f9..7e940a4 100644
--- a/compositor/GenericCompositionPlanner.cpp
+++ b/compositor/GenericCompositionPlanner.cpp
@@ -132,8 +132,49 @@ std::tuple<size_t, size_t> GenericCompositionPlanner::GetClientLayers(
   size_t client_start = 0;
   size_t client_size = 0;
 
+  /* DIAGNOSTIC (pc_x86_64): log EVERY layer for the first kDiagFrames frames,
+   * not once per reason. The previous version throttled per reason bit, so a
+   * single bufferless container layer produced exactly the same output as
+   * "every layer is broken" and the two could not be told apart. Bounded by
+   * frame count so it cannot flood, and early enough to survive the log
+   * buffer rolling. */
+  static std::atomic<unsigned> diag_frame{0};
+  constexpr unsigned kDiagFrames = 20;   /* the boot animation */
+  constexpr unsigned kDiagEvery = 300;   /* ~5s at 60fps, forever after */
+  const unsigned frame = diag_frame.fetch_add(1);
+  /* The first window alone was useless: 20 frames elapsed in 1.25 SECONDS,
+   * entirely inside the boot animation (one fullscreen layer, why=0x0,
+   * device-composited). The behaviour being chased only appears later, with
+   * the multi-layer desktop. Keep sampling for the life of the process; it is
+   * bounded to one burst per ~5s, and pc_logcat_file.sh copies logcat to
+   * /data/local/tmp/bootlog.txt, so nothing depends on the 256 KiB ring
+   * buffer surviving -- which it does not. */
+  const bool diag = frame < kDiagFrames || (frame % kDiagEvery) == 0;
+
   for (size_t z_order = 0; z_order < layers.size(); ++z_order) {
-    if (IsClientLayer(display, layers[z_order])) {
+    const unsigned why = ClientLayerReason(display, layers[z_order]);
+
+    if (diag) {
+      const auto& pi = layers[z_order]->GetLayerData().pi;
+      int dw = -1, dh = -1;
+      float sw = -1.F, sh = -1.F;
+      if (pi.display_frame.i_rect) {
+        dw = pi.display_frame.i_rect->Width();
+        dh = pi.display_frame.i_rect->Height();
+      }
+      if (pi.source_crop.f_rect) {
+        sw = pi.source_crop.f_rect->Width();
+        sh = pi.source_crop.f_rect->Height();
+      }
+      ALOGE("CLIENT-REASON f=%u z=%zu/%zu why=0x%x sf_type=%d fb=%d "
+            "disp=%dx%d src=%.0fx%.0f",
+            frame, z_order, layers.size(), why,
+            static_cast<int>(layers[z_order]->GetSfType()),
+            static_cast<int>(layers[z_order]->IsLayerUsableAsDevice()), dw, dh,
+            sw, sh);
+    }
+
+    if (why != 0) {
       if (client_size == 0) {
         client_start = z_order;
       }
@@ -141,41 +182,32 @@ std::tuple<size_t, size_t> GenericCompositionPlanner::GetClientLayers(
     }
   }
 
+  if (diag) {
+    ALOGE("CLIENT-REASON f=%u SUMMARY client_start=%zu client_size=%zu of %zu",
+          frame, client_start, client_size, layers.size());
+  }
+
   return GetExtraClientRange(display, layers, client_start, client_size,
                              use_cursor_plane);
 }
 
+/* DIAGNOSTIC (pc_x86_64): the reason bits, so callers can report WHICH
+ * condition made a layer client-composited. Remove with the logging below. */
+unsigned GenericCompositionPlanner::ClientLayerReason(
+    const ICompositorDisplay* display, const HwcLayer* layer) {
+  unsigned bits = 0;
+  if (!HardwareSupportsLayerType(layer->GetSfType())) bits |= 1U;
+  if (!layer->IsLayerUsableAsDevice()) bits |= 2U;
+  if (display->CtmByGpu()) bits |= 4U;
+  if (layer->GetLayerData().pi.RequireScalingOrPhasing() &&
+      display->ForcedScalingWithGpu())
+    bits |= 8U;
+  return bits;
+}
+
 bool GenericCompositionPlanner::IsClientLayer(const ICompositorDisplay* display,
                                               const HwcLayer* layer) {
-  const bool bad_type = !HardwareSupportsLayerType(layer->GetSfType());
-  const bool no_fb = !layer->IsLayerUsableAsDevice();
-  const bool ctm_gpu = display->CtmByGpu();
-  const bool scaling = layer->GetLayerData().pi.RequireScalingOrPhasing() &&
-                       display->ForcedScalingWithGpu();
-
-  /* DIAGNOSTIC (pc_x86_64): every layer on this port reports CLIENT and the
-   * reason is not visible anywhere. Log each distinct cause ONCE per process so
-   * this cannot flood at frame rate. Remove once the cause is understood. */
-  static std::atomic<unsigned> logged{0};
-  const unsigned bit = (bad_type ? 1U : 0U) | (no_fb ? 2U : 0U) |
-                       (ctm_gpu ? 4U : 0U) | (scaling ? 8U : 0U);
-  if (bit != 0) {
-    const unsigned seen = logged.fetch_or(bit);
-    if ((bit & ~seen) != 0) {
-      ALOGE("CLIENT-REASON: sf_type_unsupported=%d(type=%d) no_fb=%d "
-            "ctm_by_gpu=%d forced_scaling=%d",
-            static_cast<int>(bad_type), static_cast<int>(layer->GetSfType()),
-            static_cast<int>(no_fb), static_cast<int>(ctm_gpu),
-            static_cast<int>(scaling));
-    }
-  } else {
-    static std::atomic<bool> said{false};
-    if (!said.exchange(true)) {
-      ALOGE("CLIENT-REASON: at least one layer IS device-capable");
-    }
-  }
-
-  return bad_type || no_fb || ctm_gpu || scaling;
+  return ClientLayerReason(display, layer) != 0;
 }
 
 bool GenericCompositionPlanner::HardwareSupportsLayerType(
diff --git a/compositor/GenericCompositionPlanner.h b/compositor/GenericCompositionPlanner.h
index be71b82..cc1edcd 100644
--- a/compositor/GenericCompositionPlanner.h
+++ b/compositor/GenericCompositionPlanner.h
@@ -35,6 +35,9 @@ class GenericCompositionPlanner : public CompositionPlanner {
   static std::tuple<size_t, size_t> GetClientLayers(
       const ICompositorDisplay* display,
       const std::vector<const HwcLayer*>& layers, bool use_cursor_plane);
+  /* DIAGNOSTIC (pc_x86_64): reason bits behind IsClientLayer. */
+  static unsigned ClientLayerReason(const ICompositorDisplay* display,
+                                    const HwcLayer* layer);
   static bool IsClientLayer(const ICompositorDisplay* display,
                             const HwcLayer* layer);
 
