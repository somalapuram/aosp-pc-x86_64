From 4bcff603428c09c07275d59d18e64f45f3ec30ea Mon Sep 17 00:00:00 2001
From: Somalapuram Amaranath <somalapuram@gmail.com>
Date: Sun, 13 Sep 2026 07:28:54 +0530
Subject: [PATCH] audio: pick the ALSA card by capability so one image fits all
 PCs

The PC audio_policy_configuration.xml carries a single static device
address (CARD_1_DEV_0), but the sound cards do not enumerate in the same
order on every machine. On AMD the amdgpu HDMI audio is card 0 and the
analog codec is card 1; on many Intel/NVIDIA boxes the analog codec is
card 0 and the HDMI audio is card 1. A hardcoded card number therefore
sends output to a silent HDMI port and input to a capture device that
does not exist on the other vendors -- the latter is why camcorder audio
recorded zero frames and every recording failed to save.

Rather than tune a card number per machine, StreamPrimary::getCardAndDeviceId()
now reads /proc/asound/pcm and selects the endpoint by capability for the
stream direction, preferring a non-HDMI (analog codec) device and, for
capture, a digital-mic array (the SOF DMIC on Intel laptops, which is the
working mic there while the analog jack on the same card is dead) over the
analog jack. It falls back to the static XML address, then to the built-in
default, if the scan reads nothing. One image now routes audio correctly
on Intel, AMD and NVIDIA without per-board configuration.

This builds on 0001 (which stopped createAudioDevice() from clobbering the
configured mic address): 0001 preserves the hint, this selects the real
device when the hint's card number does not match the running hardware.

Change-Id: I5261da2ff812b415c4505386c1389f69c2ce4e6f
---
 .../default/include/core-impl/StreamPrimary.h |  3 +-
 audio/aidl/default/primary/StreamPrimary.cpp  | 88 ++++++++++++++++++-
 2 files changed, 88 insertions(+), 3 deletions(-)

diff --git a/audio/aidl/default/include/core-impl/StreamPrimary.h b/audio/aidl/default/include/core-impl/StreamPrimary.h
index 87dcc3b166..28fe32413a 100644
--- a/audio/aidl/default/include/core-impl/StreamPrimary.h
+++ b/audio/aidl/default/include/core-impl/StreamPrimary.h
@@ -64,7 +64,8 @@ class StreamPrimary : public StreamAlsaMonoPipe {
             primary::PrimaryMixer::kInvalidAlsaCard, primary::PrimaryMixer::kInvalidAlsaDevice};
 
     static AlsaDeviceId getCardAndDeviceId(
-            const std::vector<::aidl::android::media::audio::common::AudioDevice>& devices);
+            const std::vector<::aidl::android::media::audio::common::AudioDevice>& devices,
+            bool isInput);
     static bool useStubStream(bool isInput,
                               const ::aidl::android::media::audio::common::AudioDevice& device);
 
diff --git a/audio/aidl/default/primary/StreamPrimary.cpp b/audio/aidl/default/primary/StreamPrimary.cpp
index ac0d3020c7..5b0515d81f 100644
--- a/audio/aidl/default/primary/StreamPrimary.cpp
+++ b/audio/aidl/default/primary/StreamPrimary.cpp
@@ -17,6 +17,9 @@
 #define LOG_TAG "AHAL_StreamPrimary"
 
 #include <cstdio>
+#include <fstream>
+#include <string>
+#include <utility>
 
 #include <Log.h>
 #include <android-base/parseint.h>
@@ -151,7 +154,7 @@ ndk::ScopedAStatus StreamPrimary::setConnectedDevices(const ConnectedDevices& de
     {
         const bool useStubDriver = devices.empty() || useStubStream(mIsInput, devices[0]);
         std::lock_guard l(mLock);
-        mAlsaDeviceId = useStubDriver ? kStubDeviceId : getCardAndDeviceId(devices);
+        mAlsaDeviceId = useStubDriver ? kStubDeviceId : getCardAndDeviceId(devices, mIsInput);
     }
     if (!devices.empty()) {
         auto streamDataProcessor = getContext().getStreamDataProcessor().lock();
@@ -174,9 +177,90 @@ bool StreamPrimary::isStubStream() {
     return mAlsaDeviceId == kStubDeviceId;
 }
 
+namespace {
+
+// One image is meant to boot on Intel, AMD and NVIDIA machines, but the ALSA
+// sound cards do not enumerate in the same order on all of them. The PC audio
+// policy ships a single static address (CARD_1_DEV_0) chosen on an AMD box,
+// where the amdgpu HDMI audio is card 0 and the analog codec (Realtek, driving
+// the speaker amps) is card 1. On many Intel/NVIDIA machines the analog codec
+// is card 0 and the HDMI audio is card 1, so that same hardcoded number points
+// output at a silent HDMI port and input at a capture device that does not
+// exist -- which is exactly why camcorder recording produced zero audio frames
+// and MediaRecorder.stop() failed. Rather than tune a card number per machine,
+// pick the endpoint by capability at boot from /proc/asound/pcm, whose lines
+// look like:
+//
+//   00-03: HDMI 0 : HDMI 0 : playback 1
+//   01-00: ALC245 Analog : ALC245 Analog : playback 1 : capture 1
+//
+// Preference order, for the requested direction:
+//   1. a non-HDMI endpoint whose name looks like an internal digital mic
+//      (capture only) -- the SOF "DMIC" array on Intel laptops, which is the
+//      working mic there while the analog jack on the same card is dead;
+//   2. any non-HDMI endpoint with the wanted direction -- the analog codec
+//      (speaker for output, ALC245 line/mic for input);
+//   3. an HDMI endpoint, only as a last resort for output (a machine with no
+//      analog codec at all);
+// Returns {-1,-1} when /proc/asound/pcm cannot be read or nothing matches, so
+// the caller falls back to the static address from the policy file.
+std::pair<int, int> selectAlsaPcmByCapability(bool wantCapture) {
+    std::ifstream pcm("/proc/asound/pcm");
+    if (!pcm.is_open()) return {-1, -1};
+
+    std::pair<int, int> digitalMic{-1, -1};
+    std::pair<int, int> analog{-1, -1};
+    std::pair<int, int> hdmi{-1, -1};
+
+    std::string line;
+    while (std::getline(pcm, line)) {
+        int card = -1, device = -1;
+        if (sscanf(line.c_str(), "%d-%d:", &card, &device) != 2) continue;
+
+        const bool hasPlayback = line.find("playback") != std::string::npos;
+        const bool hasCapture = line.find("capture") != std::string::npos;
+        if (wantCapture ? !hasCapture : !hasPlayback) continue;
+
+        const bool isHdmi = line.find("HDMI") != std::string::npos ||
+                            line.find("hdmi") != std::string::npos;
+        if (isHdmi) {
+            if (hdmi.first < 0) hdmi = {card, device};
+            continue;
+        }
+
+        // Non-HDMI (analog codec). For capture, a digital-mic array is preferred
+        // over the analog jack on the same codec.
+        const bool looksLikeDmic = line.find("DMIC") != std::string::npos ||
+                                   line.find("Digital Mic") != std::string::npos ||
+                                   line.find("dmic") != std::string::npos;
+        if (wantCapture && looksLikeDmic) {
+            if (digitalMic.first < 0) digitalMic = {card, device};
+        } else if (analog.first < 0) {
+            analog = {card, device};
+        }
+    }
+
+    if (digitalMic.first >= 0) return digitalMic;
+    if (analog.first >= 0) return analog;
+    if (!wantCapture && hdmi.first >= 0) return hdmi;  // output may fall back to HDMI
+    return {-1, -1};
+}
+
+}  // namespace
+
 // static
 StreamPrimary::AlsaDeviceId StreamPrimary::getCardAndDeviceId(
-        const std::vector<AudioDevice>& devices) {
+        const std::vector<AudioDevice>& devices, bool isInput) {
+    // Auto-select the right card:device for this machine from ALSA's own list of
+    // endpoints. This is what makes one image work on Intel, AMD and NVIDIA
+    // regardless of the order the sound cards happen to enumerate in.
+    if (const auto selected = selectAlsaPcmByCapability(isInput); selected.first >= 0) {
+        LOG(DEBUG) << __func__ << ": selected by capability card id " << selected.first
+                   << ", device id " << selected.second << (isInput ? " (capture)" : " (playback)");
+        return selected;
+    }
+
+    // Fall back to the static address hint from audio_policy_configuration.xml.
     if (devices.empty() || devices[0].address.getTag() != AudioDeviceAddress::id) {
         return kDefaultCardAndDeviceId;
     }
