# Device init for the bare-metal x86_64 PC target.

on early-init
    # Real PC hardware enumerates over ACPI/PCI; give the kernel a moment
    # before first-stage mount goes looking for by-name symlinks.
    write /proc/sys/kernel/panic_on_oops 1

on init
    # zram swap. PCs have real RAM, but Android's lmkd expects swap to exist.
    write /proc/sys/vm/page-cluster 0

# Mounting the rest of the fstab is the DEVICE's job -- the generic init.rc
# does not do it. Without these two mount_all commands /data is never mounted,
# and every /data operation silently lands on the read-only ramdisk instead:
#     init: Command 'chown system system /data' ... failed: Read-only file system
#     apexd-snapshotde: Can't open /data/misc_de: No such file or directory
# which in turn stops compressed APEXes from being decompressed, so the
# tethering APEX never activates and the fallback bpfloader service triggers
#     reboot: Restarting system with command 'netbpfload-missing'
#
# system and vendor are already up via first_stage_mount; these handle the
# 'latemount' userdata entry. Mirrors device/google/cuttlefish/shared/config/
# init.vendor.rc.
on fs
    # Everything that does not need fsck
    mount_all --early

on late-fs
    # RW partitions that need fsck -- /data
    mount_all --late

# The GL implementation is chosen by pc_select_egl.sh, which runs as init's
# init_dev_config hook rather than as a service here -- see device.mk. It has to:
# ro.hardware.egl is a system_vendor_config_prop and no domain a service of ours
# could use is permitted to set it.

# Choose the GL implementation from the DRM driver that actually bound.
#
# Our own service rather than init's init_dev_config hook: that hook is defined
# and points here correctly (init.svc.init_dev_config exists, the script is
# 0755 and labelled init_dev_config_exec) but init never starts it on this
# device -- no "starting service 'init_dev_config'" is ever logged, and a
# breadcrumb property the script sets comes back empty on a full boot.
#
# vendor_shell is enough for what this script does: read sysfs, and set a
# vendor property. It needs no system binaries beyond sh and the toybox/toolbox
# applets, which domain.te carves out for vendor domains explicitly.
service pc-select-egl /vendor/bin/pc_select_egl.sh
    class core
    user root
    group root system
    oneshot
    disabled
    seclabel u:r:vendor_shell:s0

on early-init
    # Let the kernel log be read without CAP_SYSLOG.
    #
    # dmesg_restrict gates both syslog(2) and /dev/kmsg behind CAP_SYSLOG, and
    # shell -- an appdomain -- may hold no capability at all, so pc-kmsg-file
    # captures nothing and every hardware question on real metal becomes
    # unanswerable: no way to see which drivers bound, what firmware loaded, or
    # why a device did not appear. On a machine with no network and no serial
    # header that is the whole diagnostic surface.
    #
    # This is a bring-up convenience and a real (small) information leak --
    # kernel addresses and hardware detail become readable by any app. Drop it
    # before anything ships.
    write /proc/sys/kernel/dmesg_restrict 0

    exec_start pc-select-egl

# Turn pc_select_egl.sh's finding into ro.hardware.egl.
#
# Costs exactly one SurfaceFlinger abort per boot, and that is unavoidable with
# a property trigger. init appends a property-change action to the END of its
# action queue, so this runs after 'on boot' has already started SurfaceFlinger
# -- SF finds no GL implementation, aborts once, and init restarts it after the
# property lands. 'wait_for_prop' cannot close the gap either: exec_start above
# blocks init, so init could never process the action it would be waiting for.
#     F DEBUG: Abort message: 'couldn't find an OpenGL ES implementation'  (x1)
# Boot still completes in ~3.5s. Removing it needs ro.hardware.egl set before
# any action runs, which only the bootloader could do.
#
# This has to happen here rather than in the script: ro.hardware.egl is an
# exported_default_prop, whose neverallow admits only init and vendor_init as
# writers. Property sets in a vendor rc run as vendor_init, so init is the one
# that can actually assign it -- the script only reports what it saw.
#
# Both values are spelled out rather than relayed with ${vendor.pc.gpu}, so a
# garbage value cannot become a garbage ro.hardware.egl and take SurfaceFlinger
# down with "couldn't find an OpenGL ES implementation".
on property:vendor.pc.gpu=mesa
    setprop ro.hardware.egl mesa

on property:vendor.pc.gpu=angle
    setprop ro.hardware.egl angle

on post-fs-data
    mkdir /data/vendor 0771 root root
    mkdir /data/vendor/hardware 0771 root root

on boot
    # No kernel wakelock here. Writing /sys/power/wake_lock needs
    # CAP_BLOCK_SUSPEND, and commands in a vendor rc run as vendor_init:
    #     avc: denied { block_suspend } scontext=u:r:vendor_init:s0
    # shell cannot do it either (appdomain, no capabilities), so the framework
    # side in pc_stay_awake.sh -- screen_off_timeout, sleep_timeout,
    # stay_on_while_plugged_in -- is what keeps the box awake.

    # adb over Ethernet -- most desktops have no USB device-mode controller.
    setprop service.adb.tcp.port 5555

    # Input device permissions are ueventd's job, not init's -- see
    # ueventd.pc_x86_64.rc, which sets /dev/input/* to 0660 root:input for
    # every node as it appears. An earlier chmod/chown of /dev/input/event0
    # lived here: it ran once at boot, covered exactly one node out of the
    # eight a real PC enumerates, could not apply to anything hotplugged
    # afterwards, and replaced group 'input' with 'system' on whichever
    # device happened to be event0.

# Bring-up debugging: stream logcat to the second serial port (ttyS1), which
# the QEMU harness captures to a file. Userspace crash reasons live in logcat,
# not dmesg -- init reports only "Service 'x' received SIGABRT" while the cause
# is invisible on a headless boot.
#
# Uses a shell redirect rather than `logcat -f /dev/ttyS1`: -f performs log
# rotation, which needs a seekable file, so it fails on a character device
# (that attempt exited with status 1).
#
# Remove once adb over the network works.
# Writes to /dev/hvc0, a virtio-console port that the QEMU harness captures to
# a file (tools/run-qemu.sh).
#
# NOT a 16550 UART. Every byte written to an emulated 16550 is a port write and
# therefore a VM exit; a full boot's logcat is 120k+ lines, which cost enough
# exits to starve the guest and trip Android's watchdog with no real deadlock:
#     Watchdog: *** WATCHDOG KILLING SYSTEM PROCESS:
#               Blocked in handler on main thread (main) for 67s
# The main thread was never deadlocked there -- its stack showed ordinary
# ULocale/Configuration/Resources work. virtio-console carries the same data
# over a virtqueue at negligible cost, so this can stay on by default.
service logcat-serial /system/bin/sh -c "exec /system/bin/logcat -b all -v threadtime > /dev/hvc1"
    class core
    user root
    group root system log readproc
    seclabel u:r:shell:s0

on early-boot
    start logcat-serial

# Re-start the hal class once apexd has activated all APEXes.
#
# init.rc issues `class_start hal` from `on boot`, but apexd is launched
# asynchronously from `on post-fs-data` ("restart apexd") with no wait. On a
# fast device apexd wins the race; on a slow one `on boot` runs first and any
# HAL shipped inside a non-bootstrap APEX is never started -- its .rc is parsed
# afterwards, so init knows the service but nothing ever starts it.
#
# That is what happened to the audio HAL: keymint (bootstrap APEX) was up 13s
# before /apex/com.android.hardware.audio/etc/...rc was even parsed. The
# service never ran, so android.hardware.audio.core.IModule/default was never
# registered, audioserver blocked waiting for it and never published
# IAudioFlinger, and system_server hung in AudioService's constructor until the
# watchdog killed it:
#     init: Control message: Could not find
#           'aidl/android.hardware.audio.core.IModule/default' for
#           ctl.interface_start
#     D AudioSystem: getService: IAudioFlingerService retrieved: 0x0
#     W Watchdog: *** WATCHDOG KILLING SYSTEM PROCESS: Blocked in handler on
#                 main thread (main) for 65s
#       at android.media.AudioSystem.isMicrophoneMuted(Native Method)
#       at com.android.server.audio.AudioService.<init>
#
# class_start skips services that are already running, so this is idempotent
# and simply picks up whatever arrived late.
# Bring-up debugging: dump audio HAL service state directly.
#
# init's own "starting service" messages go to kmsg early and to logd once it
# is up, so they are split across two streams and easy to miss. Asking init for
# the service state is unambiguous: init.svc.<name> is empty if init does not
# know the service at all, otherwise running/stopped/restarting.
# The five helpers below run as user shell, not root.
#
# They run in the shell domain (seclabel), and a root process in that domain
# needs CAP_DAC_OVERRIDE for its usual DAC bypass -- which SELinux refuses,
# because app_neverallows.te forbids an appdomain any capability at all:
#     avc: denied { dac_override } comm="pc_kmsg_file.sh" scontext=u:r:shell:s0
# init then restarts them forever (33 times for pc-logcat-file in one boot).
# As the shell user there is no bypass to ask for: shell owns /data/local/tmp,
# and the log/graphics groups cover /dev/kmsg and screencap.
service pc-debug-dump /system_ext/bin/pc_debug_dump.sh
    class core
    user shell
    group shell system log readproc
    oneshot
    disabled
    seclabel u:r:shell:s0

# Keep the display on and the machine out of suspend during bring-up.
#
# Android's power policy assumes a battery-powered device with someone touching
# it. On a dev box nobody is, so PowerManagerService blanks the screen about ten
# seconds after the UI appears and the kernel then deep-suspends:
#     PowerManagerService: Going to sleep due to timeout
#                          (screenOffTimeout=60000, activityTimeoutWM=10000)
#     SurfaceFlinger: Setting power mode 0 on physical display
#     PM: suspend entry (deep)
# What that looks like is the boot animation playing and then a black screen
# that never comes back -- which reads as a broken display stack rather than
# power management working exactly as designed.
service pc-stay-awake /system_ext/bin/pc_stay_awake.sh
    class core
    user shell
    group shell system
    oneshot
    disabled
    seclabel u:r:shell:s0

# Bring-up: dump what SurfaceFlinger actually composited, as a PNG on hvc2.
#
# screencap reads SF's output directly, so it works even though nothing
# reaches the physical framebuffer (see tools/run-qemu.sh for the virtio-gpu
# scanout limitation) and adb over TCP is refused. Give the UI a moment to
# draw after boot completes, then capture once.
# Timed off audioserver rather than sys.boot_completed: that property is never
# set here (the device reaches LOCKED_BOOT_COMPLETED but not full
# BOOT_COMPLETED), so a trigger on it never fires. audioserver reaching
# 'running' is early but proven, so just wait long enough for the UI to draw.
# No delay argument: the script polls and decides for itself when the screen
# has something on it. Passing one here overrides that default, and a 60s value
# left over from the single-shot version put the capture 32s after the harness
# had already powered the VM off -- with the service still showing [running]
# and not one line in logcat, which looks exactly like a service that never
# started.
service pc-screencap /system_ext/bin/pc_screencap.sh
    class core
    user shell
    group shell system graphics
    oneshot
    disabled
    seclabel u:r:shell:s0

# Persist logcat to /data as well. /dev/hvc1 only exists under QEMU, so on real
# hardware the hvc1 service above produces nothing and a failing boot leaves no
# evidence at all. Started here rather than at early-boot because /data is not
# mounted yet then. Read it afterwards with:
#     sudo mount -o ro /dev/sdX5 /mnt && less /mnt/bootlog.txt
# Kernel log to /data. On real hardware there is no virtio-console and often
# no serial port, so the ring buffer is otherwise lost at power-off -- and it
# is where a display that never lights up gets explained (which DRM driver
# bound, whether firmware loaded, what connectors and modes exist).
service pc-kmsg-file /system_ext/bin/pc_kmsg_file.sh
    class core
    user shell
    group shell system log readproc
    oneshot
    seclabel u:r:shell:s0

service pc-logcat-file /system_ext/bin/pc_logcat_file.sh
    class core
    user shell
    group shell system log readproc
    seclabel u:r:shell:s0

# audioserver reaching 'running' is a trigger proven to fire from this rc.
# apexd.status=activated did NOT fire here, which is itself unexplained and
# worth revisiting -- init's own wait_for_prop on that property does succeed
# ("Wait for property 'apexd.status=activated' took 12805ms"), so the property
# is set; only our trigger on it never ran.
# Late-boot work, keyed off a property of our own.
#
# This used to trigger on init.svc.audioserver=running, which cannot work under
# enforcing: commands in a vendor rc run as vendor_init, and
#     avc: denied { read } for property=init.svc.audioserver
#          scontext=u:r:vendor_init:s0
#          tcontext=u:object_r:init_service_status_private_prop:s0
# so the whole block silently never fired -- taking the hal class restart and
# every bring-up helper with it. vendor.pc.boot is ours, labelled by
# sepolicy/property_contexts, and vendor_init may both set and read it.
on boot
    setprop vendor.pc.boot 1

on property:vendor.pc.boot=1
    class_start hal
    start pc-debug-dump
    start pc-stay-awake
    start pc-screencap
    start pc-logcat-file
    start pc-kmsg-file

service console /system/bin/sh
    class core
    console
    disabled
    user shell
    group shell log readproc
    seclabel u:r:shell:s0
    setenv HOSTNAME console

on property:ro.debuggable=1
    start console
