# pc_select_egl.sh runs here (see init.pc_x86_64.rc). It reads which DRM driver
# claimed the GPU and publishes the answer as vendor.pc.gpu, which init then
# turns into ro.hardware.egl -- see sepolicy/property.te for why the script
# cannot set that itself.
#
# This is the whole of what it needs. The five other pc_*.sh helpers do far
# more (screencap, logcat, settings, ip) and for that reason live on system_ext
# and run in shell instead; a vendor domain may not execute system files.

# init execs the script via 'seclabel u:r:vendor_shell:s0', which is not covered
# by shell.te's domain_auto_trans(shell, vendor_shell_exec, vendor_shell).
allow vendor_shell vendor_shell_exec:file entrypoint;

# #!/system/bin/sh plus the ls, grep, log and setprop applets. setprop is a
# symlink to toolbox and log to toybox; domain.te carves both out of the
# "vendor components may not execute system files" neverallow by name.
allow vendor_shell shell_exec:file rx_file_perms;
allow vendor_shell toolbox_exec:file rx_file_perms;

# Detection lists the driver bind directories under /sys/bus/*/drivers/*/.
allow vendor_shell sysfs:dir r_dir_perms;
allow vendor_shell sysfs:file r_file_perms;

set_prop(vendor_shell, vendor_pc_gpu_prop)

# Kernel-log capture. syslog_read is barred to appdomain outright
#     neverallow appdomain kernel:system { syslog_read syslog_mod syslog_console };
# so this cannot live in the shell-domain helpers; vendor_shell is not an
# appdomain. dmesg_restrict is set to 0 on the kernel command line, but
# devkmsg_open calls security_syslog() regardless, so both are needed.
allow vendor_shell kernel:system syslog_read;
# Read AND write. pc_select_egl.sh runs from exec_start on early-init, before
# logd exists, so /dev/kmsg is the only place its decision can survive -- logd
# slurps the whole ring buffer when it starts, so the line still lands in
# logcat's kernel buffer and therefore in bootlog.txt. With read-only access the
# breadcrumb was silently dropped and the boot looked exactly like one where the
# script had never run at all:
#     avc: denied { write } comm="pc_select_egl.s" name="kmsg"
#          scontext=u:r:vendor_shell:s0 tcontext=u:object_r:kmsg_device:s0
# Only untrusted and priv apps are neverallow'd this (app_neverallows.te:26,
# priv_app_all.te:235); vendor_shell is neither.
allow vendor_shell kmsg_device:chr_file rw_file_perms;
allow vendor_shell pc_debug_data_file:dir rw_dir_perms;
allow vendor_shell pc_debug_data_file:file create_file_perms;

# pc-audio-setup unmutes the ALSA mixer at boot (see pc_audio_setup.c).
# /dev/snd/controlC0 is audio_device; the shell domain the other bring-up
# helpers use can never have this, because system/sepolicy/private/app.te
# carries
#     neverallow appdomain { audio_device ... }:chr_file { read write };
# vendor_shell is not an appdomain, so the grant is allowed here.
allow vendor_shell audio_device:dir r_dir_perms;
allow vendor_shell audio_device:chr_file rw_file_perms;

# pc-v4l2-info reports what each /dev/video* node is and samples its chroma
# (see pc_v4l2_info.c). Same reasoning as the mixer above: an appdomain is
# neverallowed these nodes, so this cannot live in the shell domain with the
# other bring-up helpers.
#
# video_device, NOT camera_device: /dev/video* carries video_device, and
# granting camera_device instead left the tool denied on every node --
#     avc: denied { read write } comm="pc_v4l2_info" name="video0"
#          scontext=u:r:vendor_shell:s0 tcontext=u:object_r:video_device:s0
# camera_device is /dev/camera* and is a different type entirely.
allow vendor_shell video_device:chr_file rw_file_perms;
allow vendor_shell video_device:dir r_dir_perms;

# pc_select_egl.sh decides which GPU drives the display and publishes it as
# drm.gpu.vendor_name, which is what makes Mesa, gralloc and drm_hwcomposer
# agree on one card. It derives that from the connectors:
#
#     for c in /sys/class/drm/card[0-9]; do
#         for conn in "$c"-*; do
#             [ "$(cat "$conn/status")" = "connected" ] && drv=...card/device/driver
#
# and every one of those reads was refused, so the property was never set at all
# and the "fix" that depends on it could not work:
#
#     avc: denied { read }   comm="pc_select_egl.s" name="drm" dev="sysfs"
#          scontext=u:r:vendor_shell:s0 tcontext=u:object_r:sysfs_gpu:s0 tclass=dir
#     avc: denied { search } ... same
#
# shell, surfaceflinger, bootanim, system_server and the app domains were all
# granted sysfs_gpu already (shell.te, surfaceflinger.te); vendor_shell -- the
# domain the script actually runs in -- was the one that was missed. Read-only:
# it only ever looks.
# sysfs_gpu covers /sys/class/drm itself; sysfs_pci covers whatever the
# card*/ symlinks point AT, because genfscon takes literal path prefixes with no
# wildcards, so every GPU's own PCI node would otherwise need a per-machine line
# -- exactly the hard-coding this script exists to avoid. Granting the broad
# read instead keeps it correct on any board: an RTX 3070 Ti behind 00:01.1, an
# Ada behind the same, an Intel iGPU at 00:02.0, an AMD iGPU behind 00:08.1.
# Read-only, and shell already carries the identical pair (shell.te:20-21).
allow vendor_shell sysfs_gpu:dir r_dir_perms;
allow vendor_shell sysfs_gpu:file r_file_perms;
allow vendor_shell sysfs_pci:dir r_dir_perms;
allow vendor_shell sysfs_pci:file r_file_perms;

# pc_gpu_pm.sh writes "auto" to the discrete GPU's power/control, which lives
# under /sys/devices/pci0000:00/... and is therefore sysfs_pci (genfs_contexts).
# Read was already granted above for the card enumeration; this adds the single
# write. Without it the script logs "not writable" and the dGPU stays in D0:
#     avc: denied { write } comm="pc_gpu_pm.sh" name="control" dev="sysfs"
#          scontext=u:r:vendor_shell:s0 tcontext=u:object_r:sysfs_pci:s0
allow vendor_shell sysfs_pci:file w_file_perms;
