# vendor.pc.gpu  - the GL driver pc_select_egl.sh detected
# vendor.pc.boot - set by init at 'on boot' to key late-boot work off
# vendor.pc.ran  - breadcrumb proving the detection script executed
vendor.pc.    u:object_r:vendor_pc_gpu_prop:s0 prefix string


# Mesa's own Android options, read in-process by every GL client.
# os_get_android_option() (os_misc.c:180-193) builds these names by lowercasing
# a MESA_/NOUVEAU_ env var, mapping _ to ., prefixing "mesa." and trying
# "debug.", "vendor." and bare. Unlabelled they land on a vendor-internal type
# and every reader is refused:
#     W libc: Access denied finding property "vendor.mesa.egl.log.level"
#     W libc: Access denied finding property "vendor.mesa.nouveau.use.zink"
# which silently loses the setting -- Mesa just takes its default. Same public
# type as the GPU-selection property: written by us, read by everyone.
vendor.mesa.   u:object_r:vendor_pc_gpu_prop:s0 prefix string

# drm_hwcomposer's present-fence capability, published by pc_select_egl.sh from
# the detected GPU (true only on virtio-gpu). Same public type as the other
# GPU-selection properties: written by us, read by the composer.
ro.vendor.hwc.drm.present_fence_not_reliable    u:object_r:vendor_pc_gpu_prop:s0 exact string
