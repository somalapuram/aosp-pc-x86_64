<?xml version="1.0" encoding="UTF-8"?>
<!--
  Primary audio HAL policy for this device.

  This replaces frameworks/av/services/audiopolicy/config/primary_audio_policy_configuration.xml,
  which was being copied verbatim and asks for 44100 Hz:

      <profile format="AUDIO_FORMAT_PCM_16_BIT"
               samplingRates="44100" channelMasks="AUDIO_CHANNEL_OUT_STEREO"/>

  That rate is what the driver rejects. For a built-in device the AIDL HAL does
  NOT negotiate with the hardware - openProxyForAttachedDevice() calls
  profile_fill_builtin_device_info(), which fills the profile from this config
  rather than querying the card - so whatever is written here is demanded of
  the PCM verbatim:

      alsa_device_proxy: proxy_open(card:0 device:0 PCM_OUT)
      alsa_device_proxy: proxy_open() pcm_is_ready() failed:
                         cannot set hw params: Invalid argument
      AHAL_StreamPrimary: Function: start Line: 88 Failed
      AHAL_Stream: cycle: start failed: -19

  and the stream drops into ERROR, after which every write is refused with
  "command 'burst' can not be handled in the state ERROR". Nothing downstream
  reports a fault, so the only symptom is silence.

  48000 because that is what the SOF pipeline runs at: the topology loaded on
  this machine is sof-hda-generic-2ch.tplg, and the ACE pipelines it describes
  are 48 kHz. 44100 is simply not a rate this path offers. Content at 44.1 kHz
  still plays - AudioFlinger resamples to the output rate, which is the normal
  arrangement on any device whose DSP is fixed-rate.

  The input profile moves for the same reason. It asked for 8000,16000 mono,
  which are telephony rates; the capture device here is the SoC DMIC array
  (Dmic0 in the mixer), and it runs at 48 kHz like the rest of the pipeline.

  ONLY the rates change here. An earlier revision also widened the input
  channelMasks to "AUDIO_CHANNEL_IN_MONO,AUDIO_CHANNEL_IN_STEREO", which was
  speculative and not needed for anything, and the AIDL HAL rejected the
  resulting config outright:

      F AHAL_Config: convertCollectionToAidl Line: 128 Failed result (BAD_VALUE)
      F libc: Fatal signal 6 (SIGABRT) in android.hardware.audio.service-aidl.example
              AudioPolicyConfigXmlConverter::init()

  The HAL then crash-looped, audioserver never came up, and the device never
  reached boot_completed - a non-booting device caused by a change that was
  not fixing anything. This converter is strict and its failures are fatal
  rather than diagnostic, so keep the delta from the stock config as small as
  the problem requires.
-->
<module name="primary" halVersion="2.0">
    <attachedDevices>
        <item>Speaker</item>
        <item>Built-In Mic</item>
    </attachedDevices>
    <defaultOutputDevice>Speaker</defaultOutputDevice>
    <mixPorts>
        <mixPort name="primary output" role="source" flags="AUDIO_OUTPUT_FLAG_PRIMARY">
            <profile name="" format="AUDIO_FORMAT_PCM_16_BIT"
                     samplingRates="48000" channelMasks="AUDIO_CHANNEL_OUT_STEREO"/>
        </mixPort>
        <mixPort name="primary input" role="sink">
            <!-- Stereo, not mono. openProxyForAttachedDevice() does not ask the
                 card what it can do; profile_fill_builtin_device_info() fills
                 the profile straight from this file and demands it verbatim of
                 the driver. Asking card 0 device 0 for one channel is refused:

                   proxy_open(card:0 device:0 PCM_IN)
                   proxy_open() pcm_is_ready() failed: cannot set hw params:
                       Invalid argument
                   openProxyForAttachedDevice: failed to open device,
                       address=<0,0> error=-12
                   AHAL_StreamPrimary: Function: start Line: 88 Failed

                 which leaves the input stream in state ERROR, so every later
                 burst returns -ENOSYS and AudioFlinger reads framesRead=-38.
                 HDA capture endpoints are stereo; a mono capture stream is a
                 phone codec convention this card does not share. Nothing is
                 lost by opening stereo: AudioFlinger downmixes to whatever the
                 client asked for, and the camcorder profile still records one
                 channel.

                 The output side of this file needed the same lesson at 44100
                 and is deliberately untouched here, since PCM_OUT opens
                 cleanly on this card.

                 One value, not a list. A comma separated channelMasks converts
                 to -1 and aborts the HAL during config parsing, which stops the
                 device booting at all; that mistake cost a boot already. -->
            <!-- 32-bit, not 16. The internal mics are the SOF DMIC array on
                 card 0 DEVICE 6 ("DMIC Raw" in /proc/asound/pcm), and that
                 endpoint is S32_LE only:

                   tinypcminfo -D 0 -d 6
                     Format Name: S32_LE
                     Rate:        min=48000Hz max=48000Hz
                     Channels:    min=2      max=2
                     Sample bits: min=32     max=32

                 Asking it for 16 bits is refused exactly like asking device 0
                 for one channel was ("cannot set hw params: Invalid argument"),
                 because openProxyForAttachedDevice() never asks the card what it
                 supports; profile_fill_builtin_device_info() fills the profile
                 from this file and demands it verbatim of the driver. The
                 samples carry about 27 significant bits left-justified in the
                 32-bit container; AudioFlinger converts down to whatever the
                 recording client asked for. -->
            <profile name="" format="AUDIO_FORMAT_PCM_32_BIT"
                     samplingRates="48000" channelMasks="AUDIO_CHANNEL_IN_STEREO"/>
        </mixPort>
   </mixPorts>
   <devicePorts>
        <devicePort tagName="Speaker" type="AUDIO_DEVICE_OUT_SPEAKER" role="sink">
        </devicePort>

        <!-- address is what selects the ALSA capture device.
             StreamPrimary::getCardAndDeviceId() rfind()s "CARD_" in this string
             and sscanf()s "CARD_%d_DEV_%d" from there; with no match it returns
             kDefaultCardAndDeviceId, which is card 0 device 0. This machine has
             two capture PCMs: 00-00 "HDA Analog", the analog jack, and 00-06
             "DMIC Raw", the internal mics, so the default recorded an empty
             socket. Measured: the jack sat at RMS -66.5 dBFS and did not move
             (-66.6) while a 1 kHz tone played through the speaker; the DMIC went
             from -60.2 to -29.1, i.e. +31 dB. The "bottom_" prefix is ignored by
             the parser and kept only so the address still reads as a microphone
             position, matching the value the HAL would otherwise have forced. -->
        <devicePort tagName="Built-In Mic" type="AUDIO_DEVICE_IN_BUILTIN_MIC" role="source"
                    address="bottom_CARD_0_DEV_6">
        </devicePort>
    </devicePorts>
    <routes>
        <route type="mix" sink="Speaker"
               sources="primary output"/>
        <route type="mix" sink="primary input"
               sources="Built-In Mic"/>
    </routes>
</module>
