# Kernel config fragment for bare-metal x86_64 Android (Intel iGPU + AMD GPU).
#
# Merged on top of:
#   1. arch/x86/configs/x86_64_defconfig
#   2. android_17/kernel/configs/b/android-6.12/android-base.config
#
# Contains only what android-base.config does not already require.
# See doc/03-kernel.md sections 5.7-5.10.
# KEEP GROUPED BY SUBSYSTEM

# --- Android core not covered by the base fragment -------------------------
CONFIG_ANDROID_BINDER_IPC=y
CONFIG_ANDROID_BINDERFS=y
CONFIG_PSI=y

# --- cgroups ---------------------------------------------------------------
# android-base.config requires CGROUPS/CGROUP_SCHED/CGROUP_FREEZER/
# CGROUP_CPUACCT/CGROUP_BPF but NOT MEMCG -- and x86_64_defconfig leaves it
# off. Android's /system/etc/cgroups.json asks for the v2 'memory' controller:
#
#   v2 root: /sys/fs/cgroup    controllers: freezer, memory
#   v1: blkio -> /dev/blkio, cpu -> /dev/cpuctl, cpuset -> /dev/cpuset
#
# Without MEMCG there is no memory controller to mount, so init's builtin
# SetupCgroups action fails and takes down every service after it:
#     init: Command 'SetupCgroups' failed: Failed to setup cgroups: Invalid argument
#     libprocessgroup: Failed to make and chown /sys/fs/cgroup/system/uid_0
#     init: Service 'ueventd' failed to start due to a fatal error
#     reboot: ... 'bootloader,bootstrap-apexd-failed'
# The reported failures are in ueventd/apexd/init_dev_config, several lines
# after the actual cause.
CONFIG_MEMCG=y

# cpu controller bandwidth limits (cpu.max), used by the /dev/cpuctl groups.
CONFIG_CFS_BANDWIDTH=y

# Legacy cgroup v1 controllers.
#
# Upstream is deprecating cgroup v1 and has moved individual controllers behind
# their own options, all defaulting to n (init/Kconfig CPUSETS_V1, MEMCG_V1 in
# 7.2). Android still mounts blkio, cpu and cpuset as v1 per cgroups.json, so
# CPUSETS is not sufficient on its own -- the mount is rejected:
#     libprocessgroup: Failed to mount controller cpuset: Invalid argument
#     libprocessgroup: Failed to setup cpuset cgroup
#
# blkio and cpu v1 are not separately gated; they ride on BLK_CGROUP and
# CGROUP_SCHED. Only cpuset and memcg need their v1 option turned back on.
# MEMCG_V1 is defensive here: cgroups.json puts memory under v2, but Android's
# task profiles can still reference v1 memory paths.
#
# This is a real mainline-vs-ACK divergence: ACK keeps v1 enabled for Android.
CONFIG_CPUSETS_V1=y
CONFIG_MEMCG_V1=y

# --- Filesystems -----------------------------------------------------------
# Android 17 system/vendor images are erofs; /data is ext4 or f2fs.
CONFIG_EROFS_FS=y
CONFIG_EROFS_FS_ZIP=y
CONFIG_EXT4_FS=y
CONFIG_EXT4_FS_SECURITY=y
CONFIG_F2FS_FS=y
CONFIG_FUSE_FS=y
CONFIG_OVERLAY_FS=y
CONFIG_TMPFS_XATTR=y
CONFIG_TMPFS_POSIX_ACL=y

# --- Block / device mapper -------------------------------------------------
CONFIG_BLK_DEV_DM=y
CONFIG_DM_VERITY=y
CONFIG_DM_CRYPT=y
CONFIG_DM_SNAPSHOT=y
# Required for GPT partition labels -> /dev/block/by-name/* symlinks.
# Missing this presents as an fstab bug. See doc/06-boot-and-storage.md.
CONFIG_EFI_PARTITION=y

# --- Graphics: one kernel, both vendors ------------------------------------
# Runtime PCI-ID matching selects the driver. See doc/05-graphics.md section 2.
CONFIG_DRM=y
CONFIG_DRM_KMS_HELPER=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_DRM_GEM_SHMEM_HELPER=y

# Intel Gen8..Gen12 (Broadwell .. Alder Lake)
CONFIG_DRM_I915=y
# Intel Xe / Arc / Lunar Lake and newer
CONFIG_DRM_XE=y

# AMD. DRM_AMD_DC is required for modesetting on any modern part -- without
# Display Core you get compute and no display.
CONFIG_DRM_AMDGPU=y
CONFIG_DRM_AMDGPU_SI=y
CONFIG_DRM_AMDGPU_CIK=y
CONFIG_DRM_AMD_DC=y
CONFIG_DRM_AMD_DC_FP=y

# AMD Display Core's DML (display mode library) has very large stack frames,
# and clang generates larger ones than GCC. With the 2048 default and
# CONFIG_WERROR=y the build fails outright:
#
#   display_mode_vba_30.c: error: stack frame size (2320) exceeds limit (2048)
#   in 'dml30_ModeSupportAndSystemConfigurationFull' [-Werror,-Wframe-larger-than]
#
# dcn30/dcn31/dcn314 need 2320/2128/2152. Note this is the *global* limit --
# dc/dml/Makefile only adds a stricter per-file flag when FRAME_WARN < 2048,
# so raising it here is sufficient and does not get overridden.
CONFIG_FRAME_WARN=4096

# --- GPU firmware, built into the kernel -----------------------------------
#
# Modern Intel GPUs cannot run without firmware, and i915 requests it during
# probe -- which happens long before /vendor is mounted. Shipping the blobs on
# a partition is therefore too late; they must be linked into the image.
#
# On Meteor Lake this is not optional. Without GuC there is no GPU submission
# at all, so the display engine still scans out (a mouse cursor appears) while
# nothing ever renders:
#     i915 0000:00:02.0: [drm] *ERROR* GT0: GuC firmware i915/mtl_guc_70.bin:
#                        fetch failed -ENOENT
#     i915 0000:00:02.0: [drm] *ERROR* GT0: GuC initialization failed -ENOENT
#     i915 0000:00:02.0: [drm] Failed to load DMC firmware i915/mtl_dmc.bin
#                        (-ENOENT). Disabling runtime power management.
#
#   mtl_guc_70.bin   GuC  - submission; nothing renders without it
#   mtl_dmc.bin      DMC  - display power management
#   mtl_huc_gsc.bin  HuC  - media acceleration
#   mtl_gsc_1.bin    GSC  - graphics system controller
#
# Files live in firmware/ in this project, decompressed from linux-firmware
# (the distro ships them zstd-compressed; CONFIG_EXTRA_FIRMWARE needs plain
# files). Add entries for other hardware -- adl_/tgl_ for older Intel,
# amdgpu/* for AMD -- and keep the list narrow, since each blob is linked in.
CONFIG_EXTRA_FIRMWARE="i915/mtl_guc_70.bin i915/mtl_dmc.bin i915/mtl_huc_gsc.bin i915/mtl_gsc_1.bin"
CONFIG_EXTRA_FIRMWARE_DIR="@X86_ROOT@/firmware"


# --- Camera: V4L2 + UVC ----------------------------------------------------
# The external camera HAL enumerates /dev/video*, and without MEDIA_SUPPORT
# there is no V4L2 core at all -- so no /dev/video* node can ever appear, with
# or without a webcam plugged in. On real hardware that shows up as the Camera
# app crashing rather than saying "no camera":
#     FATAL EXCEPTION: main  (com.android.camera2)
#     java.lang.ArrayIndexOutOfBoundsException: length=0; index=0
#         at com.android.camera.app.CameraController.getCharacteristics
# Camera2 asks for camera[0] against an empty list. The HAL itself was already
# correct -- "external webcam service is starting" and cameraserver connects to
# it -- it simply had nothing to enumerate.
#
# UVC covers essentially every USB webcam and every laptop's built-in camera,
# which on a PC is a USB device internally. No firmware blob is needed.
CONFIG_MEDIA_SUPPORT=y
CONFIG_MEDIA_SUPPORT_FILTER=y
CONFIG_MEDIA_CAMERA_SUPPORT=y
CONFIG_MEDIA_USB_SUPPORT=y
CONFIG_VIDEO_DEV=y
CONFIG_USB_VIDEO_CLASS=y
CONFIG_USB_VIDEO_CLASS_INPUT_EVDEV=y
CONFIG_V4L2_MEM2MEM_DEV=y
CONFIG_VIDEOBUF2_V4L2=y

# --- Ethernet: Intel I225/I226 ---------------------------------------------
# e1000e and r8169 are already on, and the bring-up machine still came up with
# no eth0 at all -- only lo, dummy0 and tunnels. Recent Intel desktop/laptop
# boards use I225/I226, which is igc, a separate driver from e1000e.
CONFIG_IGC=y
CONFIG_IGB=y

# --- Touchpad --------------------------------------------------------------
# The bring-up laptop came up with a working built-in keyboard ("AT Translated
# Set 2 keyboard") and a USB mouse, and NO touchpad of any kind in the input
# list. i2c-hid was already enabled; what was missing is the I2C controller it
# sits on. On Intel laptops that is the Synopsys DesignWare block, and without
# I2C_DESIGNWARE_CORE the bus never appears, so i2c-hid has nothing to attach
# to and the touchpad is invisible rather than broken.
# COMMON_CLK first: I2C_DESIGNWARE_PLATFORM is
#     depends on (ACPI && COMMON_CLK) || !ACPI
# so with ACPI on and COMMON_CLK off the option is not even offered -- it
# silently vanishes from .config rather than failing, which is how the first
# attempt at this shipped a kernel that still had no touchpad.
CONFIG_COMMON_CLK=y

# The Intel LPSS bridge is what actually exposes those I2C controllers on a
# laptop; the DesignWare driver binds to what LPSS enumerates.
CONFIG_MFD_INTEL_LPSS=y
CONFIG_MFD_INTEL_LPSS_ACPI=y
CONFIG_MFD_INTEL_LPSS_PCI=y

CONFIG_I2C_DESIGNWARE_CORE=y
CONFIG_I2C_DESIGNWARE_PLATFORM=y

# Touchpads report as HID multitouch devices; without this they enumerate as a
# plain mouse at best.
CONFIG_HID_MULTITOUCH=y

# The PS/2 fallback for laptops that still use it. Synaptics and ALPS were
# already on; Elantech is common and was not.
CONFIG_MOUSE_PS2_ELANTECH=y
CONFIG_MOUSE_PS2_ELANTECH_SMBUS=y
CONFIG_MOUSE_ELAN_I2C=y
CONFIG_MOUSE_ELAN_I2C_I2C=y
CONFIG_MOUSE_ELAN_I2C_SMBUS=y

# --- WiFi: Intel (iwlwifi) -------------------------------------------------
# cfg80211/mac80211 were already on with no device driver behind them, so the
# bring-up laptop booted with no wlan interface at all -- only lo, dummy0 and
# tunnels. This is an Intel laptop, so iwlwifi covers it.
#
# Both operating-mode modules are needed: mvm drives everything from 7260
# onwards (AC 9560, AX200/201/210/211, BE200), dvm the older 4965/5000/6000
# parts. Firmware comes from /vendor/firmware -- see tools/fetch-firmware.sh --
# not CONFIG_EXTRA_FIRMWARE, because the right blob depends on the exact chip
# and linking 249 MB into the kernel to cover them all is absurd.
CONFIG_WIRELESS=y
CONFIG_IWLWIFI=y
CONFIG_IWLMVM=y
CONFIG_IWLDVM=y
CONFIG_IWLWIFI_OPMODE_MODULAR=y

# --- Bluetooth: Intel over USB ---------------------------------------------
# CONFIG_BT was off entirely, so there was no Bluetooth subsystem to fail.
# btusb plus btintel covers every Intel combo card; the profiles below are what
# Android's stack actually binds to.
CONFIG_BT=y
CONFIG_BT_BREDR=y
CONFIG_BT_LE=y
CONFIG_BT_RFCOMM=y
CONFIG_BT_RFCOMM_TTY=y
CONFIG_BT_BNEP=y
CONFIG_BT_HIDP=y
CONFIG_BT_HCIBTUSB=y
CONFIG_BT_HCIBTUSB_BCM=y
CONFIG_BT_INTEL=y

# virtio-gpu, for the QEMU development loop in doc/02-host-setup.md
CONFIG_DRM_VIRTIO_GPU=y


# dma-buf heaps -- minigbm's HAS_DMABUF_SYSTEM_HEAP path
CONFIG_DMABUF_HEAPS=y
CONFIG_DMABUF_HEAPS_SYSTEM=y

# --- Input: real PC hardware -----------------------------------------------
# NOTE: there is no CONFIG_I2C_HID in 7.2; it is I2C_HID_CORE + I2C_HID_ACPI.
# Without I2C_HID_ACPI modern laptop touchpads do not enumerate.
CONFIG_INPUT_EVDEV=y
CONFIG_HID_GENERIC=y
CONFIG_USB_HID=y
CONFIG_I2C_HID_CORE=y
CONFIG_I2C_HID_ACPI=y
CONFIG_KEYBOARD_ATKBD=y
CONFIG_MOUSE_PS2=y
CONFIG_UHID=y
CONFIG_HIDRAW=y

# --- Audio -----------------------------------------------------------------
# snd_hda_intel covers essentially all Intel and AMD PC audio.
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_HDA_INTEL=y
CONFIG_SND_SOC=y

# --- Storage ---------------------------------------------------------------
CONFIG_BLK_DEV_NVME=y
CONFIG_ATA=y
CONFIG_SATA_AHCI=y

# Booting from a USB stick needs the whole USB storage path built in, not as
# modules -- the root filesystem lives on it, so nothing can be loaded later.
# USB mass storage presents as SCSI, which is also why androidboot.boot_part_uuid
# resolves correctly there: init's boot-device lookup tries MMC / NVMe / SCSI
# matchers, and usb-storage lands in the SCSI one.
#
# UAS (USB Attached SCSI) is what most USB 3.0 sticks and enclosures actually
# speak; without it they fall back to the older bulk-only transport, which is
# slower and not supported by every device.
CONFIG_USB_STORAGE=y
CONFIG_USB_UAS=y

# --- USB gadget (USB adb; most desktops have no device-mode controller) ----
CONFIG_USB=y
CONFIG_USB_SUPPORT=y
CONFIG_USB_GADGET=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_F_FS=y

# --- Power / ACPI ----------------------------------------------------------
CONFIG_SUSPEND=y
CONFIG_PM_WAKELOCKS=y
CONFIG_ACPI=y
CONFIG_ACPI_BUTTON=y
CONFIG_ACPI_BATTERY=y
CONFIG_ACPI_AC=y
CONFIG_CPU_FREQ=y
CONFIG_CPU_FREQ_STAT=y
CONFIG_RTC_CLASS=y

# --- Networking gates ------------------------------------------------------
# x86_64_defconfig leaves NETFILTER_ADVANCED off, which hides ~104 symbols
# across net/netfilter, net/ipv4/netfilter and net/ipv6/netfilter -- including
# most of the NETFILTER_XT_* and NF_CONNTRACK_* helpers that
# android-base.config requires for netd. Without this, merge_config sets them
# and olddefconfig silently drops them again on unmet dependencies.
CONFIG_NETFILTER_ADVANCED=y

# After 6.12 the legacy iptables/arptables tables were moved behind new
# *_LEGACY gates. android-base.config (6.12) predates the split, so every
# IP_NF_*/IP6_NF_* table it asks for is dropped on unmet dependencies unless
# these are set. netd still uses the legacy interface.
CONFIG_NETFILTER_XTABLES_LEGACY=y
CONFIG_IP_NF_IPTABLES_LEGACY=y
CONFIG_IP6_NF_IPTABLES_LEGACY=y

# INET_DIAG gates INET_DIAG_DESTROY / INET_UDP_DIAG, which Android uses to
# tear down sockets on network changes and VPN teardown.
CONFIG_INET_DIAG=y

# IFB depends on NET_ACT_MIRRED || NFT_FWD_NETDEV; Android's traffic shaping
# uses the mirred path.
CONFIG_NET_ACT_MIRRED=y

# HID_PLAYSTATION (required by android-base.config) depends on this.
CONFIG_LEDS_CLASS_MULTICOLOR=y

# --- Networking: virtio-net and e1000e for the QEMU dev VM -----------------
CONFIG_VIRTIO_NET=y
CONFIG_E1000E=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_CONSOLE=y

# --- Debugging: serial console is not optional for bring-up ----------------
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_MAGIC_SYSRQ=y
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
