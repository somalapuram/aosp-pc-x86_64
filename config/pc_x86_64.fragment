# Kernel config fragment for bare-metal x86_64 Android (Intel iGPU + AMD GPU).
#
# Merged on top of:
#   1. arch/x86/configs/x86_64_defconfig
#   2. android_17/kernel/configs/b/android-6.12/android-base.config
#
# Contains only what android-base.config does not already require.
# See doc/03-kernel.md sections 5.7-5.10.
# KEEP GROUPED BY SUBSYSTEM

# --- Android core not covered by the base fragment -------------------------
CONFIG_ANDROID_BINDER_IPC=y
CONFIG_ANDROID_BINDERFS=y
CONFIG_PSI=y

# --- cgroups ---------------------------------------------------------------
# android-base.config requires CGROUPS/CGROUP_SCHED/CGROUP_FREEZER/
# CGROUP_CPUACCT/CGROUP_BPF but NOT MEMCG -- and x86_64_defconfig leaves it
# off. Android's /system/etc/cgroups.json asks for the v2 'memory' controller:
#
#   v2 root: /sys/fs/cgroup    controllers: freezer, memory
#   v1: blkio -> /dev/blkio, cpu -> /dev/cpuctl, cpuset -> /dev/cpuset
#
# Without MEMCG there is no memory controller to mount, so init's builtin
# SetupCgroups action fails and takes down every service after it:
#     init: Command 'SetupCgroups' failed: Failed to setup cgroups: Invalid argument
#     libprocessgroup: Failed to make and chown /sys/fs/cgroup/system/uid_0
#     init: Service 'ueventd' failed to start due to a fatal error
#     reboot: ... 'bootloader,bootstrap-apexd-failed'
# The reported failures are in ueventd/apexd/init_dev_config, several lines
# after the actual cause.
CONFIG_MEMCG=y

# cpu controller bandwidth limits (cpu.max), used by the /dev/cpuctl groups.
CONFIG_CFS_BANDWIDTH=y

# Legacy cgroup v1 controllers.
#
# Upstream is deprecating cgroup v1 and has moved individual controllers behind
# their own options, all defaulting to n (init/Kconfig CPUSETS_V1, MEMCG_V1 in
# 7.2). Android still mounts blkio, cpu and cpuset as v1 per cgroups.json, so
# CPUSETS is not sufficient on its own -- the mount is rejected:
#     libprocessgroup: Failed to mount controller cpuset: Invalid argument
#     libprocessgroup: Failed to setup cpuset cgroup
#
# blkio and cpu v1 are not separately gated; they ride on BLK_CGROUP and
# CGROUP_SCHED. Only cpuset and memcg need their v1 option turned back on.
# MEMCG_V1 is defensive here: cgroups.json puts memory under v2, but Android's
# task profiles can still reference v1 memory paths.
#
# This is a real mainline-vs-ACK divergence: ACK keeps v1 enabled for Android.
CONFIG_CPUSETS_V1=y
CONFIG_MEMCG_V1=y

# --- Filesystems -----------------------------------------------------------
# Android 17 system/vendor images are erofs; /data is ext4 or f2fs.
CONFIG_EROFS_FS=y
CONFIG_EROFS_FS_ZIP=y
CONFIG_EXT4_FS=y
CONFIG_EXT4_FS_SECURITY=y
CONFIG_F2FS_FS=y
CONFIG_FUSE_FS=y
CONFIG_OVERLAY_FS=y
CONFIG_TMPFS_XATTR=y
CONFIG_TMPFS_POSIX_ACL=y

# --- Block / device mapper -------------------------------------------------
CONFIG_BLK_DEV_DM=y
CONFIG_DM_VERITY=y
CONFIG_DM_CRYPT=y
CONFIG_DM_SNAPSHOT=y
# Required for GPT partition labels -> /dev/block/by-name/* symlinks.
# Missing this presents as an fstab bug. See doc/06-boot-and-storage.md.
CONFIG_EFI_PARTITION=y

# --- A display before any GPU driver binds ---------------------------------
#
# Without this there is NO console on real hardware until amdgpu/i915/nouveau
# successfully probes. CONFIG_FB is off, there is no FB_EFI or FB_VESA, and the
# machine boots via BOOTX64.EFI so UEFI has already left VGA text mode behind --
# CONFIG_VGA_CONSOLE is therefore worth nothing. fbcon only appears once a real
# DRM driver comes up and DRM_FBDEV_EMULATION creates it.
#
# That is fine right up until the GPU driver is what hangs, and then it is the
# difference between a diagnosis and a black screen. On the AMD/NVIDIA
# workstation the machine locked up hard during early boot -- NumLock dead, USB
# power gone -- and console=tty0 with loglevel=8 produced not one character,
# because tty0 did not exist yet.
#
# SYSFB_SIMPLEFB hands the UEFI GOP framebuffer the kernel inherited to
# DRM_SIMPLEDRM, which registers a real DRM device immediately, at which point
# fbcon exists and the screen works. The GPU driver takes over later:
# drm_aperture_remove_conflicting_framebuffers() evicts simpledrm when amdgpu
# binds, so there is no conflict and nothing to unload by hand. This is exactly
# how a Linux distro shows you a boot log before it has a GPU driver.
CONFIG_SYSFB=y
CONFIG_SYSFB_SIMPLEFB=y
CONFIG_DRM_SIMPLEDRM=y
# Writes to the UEFI framebuffer from the very first instants of kernel
# execution, before even simpledrm. `earlycon=efifb keep_bootcon` on the command
# line is what makes an early hang visible at all.
CONFIG_EFI_EARLYCON=y

# --- Graphics: one kernel, both vendors ------------------------------------
# Runtime PCI-ID matching selects the driver. See doc/05-graphics.md section 2.
CONFIG_DRM=y
CONFIG_DRM_KMS_HELPER=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_DRM_GEM_SHMEM_HELPER=y

# Intel Gen8..Gen12 (Broadwell .. Alder Lake)
CONFIG_DRM_I915=y
# Intel Xe / Arc / Lunar Lake and newer
CONFIG_DRM_XE=y

# AMD. DRM_AMD_DC is required for modesetting on any modern part -- without
# Display Core you get compute and no display.
CONFIG_DRM_AMDGPU=y
CONFIG_DRM_AMDGPU_SI=y
CONFIG_DRM_AMDGPU_CIK=y
CONFIG_DRM_AMD_DC=y
CONFIG_DRM_AMD_DC_FP=y

# NVIDIA, via nouveau. Mesa's nouveau gallium driver drives Fermi and newer
# through this; there is no proprietary blob anywhere in the picture.
#
# GSP is not optional on Turing and later. From Turing the display and memory
# init paths moved behind the GPU System Processor, and nouveau drives them by
# handing signed firmware to the GSP rather than touching the hardware itself.
# Without NVIDIA_GSP_FIRMWARE the driver still binds on those cards and then
# fails to bring up a display, which looks like a nouveau bug and is not one.
#
# The firmware is large (tens of MB per chip generation) and chip-specific, so
# it is served by the userspace helper below rather than linked in with
# CONFIG_EXTRA_FIRMWARE the way the four small i915 blobs are.

# Pre-GCN AMD -- Radeon HD 2000..8000, Terascale 1/2/3 -- which amdgpu does not
# cover. Without it those machines fall to simpledrm and get no GL at all.
CONFIG_DRM_RADEON=y

CONFIG_DRM_NOUVEAU=y
CONFIG_NOUVEAU_LEGACY_CTX_SUPPORT=n
CONFIG_DRM_NOUVEAU_GSP_DEFAULT=y

# AMD Display Core's DML (display mode library) has very large stack frames,
# and clang generates larger ones than GCC. With the 2048 default and
# CONFIG_WERROR=y the build fails outright:
#
#   display_mode_vba_30.c: error: stack frame size (2320) exceeds limit (2048)
#   in 'dml30_ModeSupportAndSystemConfigurationFull' [-Werror,-Wframe-larger-than]
#
# dcn30/dcn31/dcn314 need 2320/2128/2152. Note this is the *global* limit --
# dc/dml/Makefile only adds a stricter per-file flag when FRAME_WARN < 2048,
# so raising it here is sufficient and does not get overridden.
CONFIG_FRAME_WARN=4096

# --- GPU firmware, built into the kernel -----------------------------------
#
# Modern Intel GPUs cannot run without firmware, and i915 requests it during
# probe -- which happens long before /vendor is mounted. Shipping the blobs on
# a partition is therefore too late; they must be linked into the image.
#
# On Meteor Lake this is not optional. Without GuC there is no GPU submission
# at all, so the display engine still scans out (a mouse cursor appears) while
# nothing ever renders:
#     i915 0000:00:02.0: [drm] *ERROR* GT0: GuC firmware i915/mtl_guc_70.bin:
#                        fetch failed -ENOENT
#     i915 0000:00:02.0: [drm] *ERROR* GT0: GuC initialization failed -ENOENT
#     i915 0000:00:02.0: [drm] Failed to load DMC firmware i915/mtl_dmc.bin
#                        (-ENOENT). Disabling runtime power management.
#
#   mtl_guc_70.bin   GuC  - submission; nothing renders without it
#   mtl_dmc.bin      DMC  - display power management
#   mtl_huc_gsc.bin  HuC  - media acceleration
#   mtl_gsc_1.bin    GSC  - graphics system controller
#
# Files live in firmware/ in this project, decompressed from linux-firmware
# (the distro ships them zstd-compressed; CONFIG_EXTRA_FIRMWARE needs plain
# files). Add entries for other hardware -- adl_/tgl_ for older Intel,
# amdgpu/* for AMD -- and keep the list narrow, since each blob is linked in.
#
# AMD Raphael (the Ryzen 7000 iGPU, 1002:164e, gfx1036) is linked in for the
# same reason as the i915 blobs and one more: amdgpu asks with the synchronous
# request_firmware() during a built-in driver's probe, so the userspace helper
# below cannot answer in time and the GPU never initialises at all. Twelve
# files, 2.7 MB uncompressed -- small enough to link, unlike NVIDIA.
#
#   gc_10_3_6_*      graphics core: CP (ce/me/pfp), compute (mec/mec2), RLC
#   psp_13_0_5_*     platform security processor: asd, ta, toc
#   sdma_5_2_6       DMA engine
#   vcn_3_1_2        video codec
#   dcn_3_1_5_dmcub  display microcontroller -- THE one that matters here
#   dcn_3_1_6_dmcub  display microcontroller for the 3.1.6 variant
#
# Both DCN revisions are shipped because the IP version is not guessable from
# the part name and getting it wrong is fatal, not degraded. This board asks for
# 3.1.5; only 3.1.6 was linked in, and the whole GPU died on it:
#
#   amdgpu: Direct firmware load for amdgpu/dcn_3_1_5_dmcub.bin failed, error -2
#   amdgpu: Falling back to sysfs fallback for: amdgpu/dcn_3_1_5_dmcub.bin
#   amdgpu: early_init of IP block <dm> failed -19
#   amdgpu: Fatal error during GPU init
#   amdgpu: MODE2 reset
#
# One missing display-microcontroller blob takes down the entire driver, so
# there is no GPU at all, EGL falls back to software, and the desktop crawls.
# The stall between those lines is 63 seconds of firmware_class timeout.
#
# NVIDIA is deliberately NOT here. GA10x nouveau needs GSP, and that blob alone
# is 26-52 MB compressed -- it does not belong in a kernel image. Serving GPU
# firmware from an initramfs, the way every Linux distro does, is the change
# that makes NVIDIA possible; see doc/08-roadmap.md.
CONFIG_EXTRA_FIRMWARE="i915/mtl_guc_70.bin i915/mtl_dmc.bin i915/mtl_huc_gsc.bin i915/mtl_gsc_1.bin amdgpu/gc_10_3_6_ce.bin amdgpu/gc_10_3_6_me.bin amdgpu/gc_10_3_6_mec.bin amdgpu/gc_10_3_6_mec2.bin amdgpu/gc_10_3_6_pfp.bin amdgpu/gc_10_3_6_rlc.bin amdgpu/psp_13_0_5_asd.bin amdgpu/psp_13_0_5_ta.bin amdgpu/psp_13_0_5_toc.bin amdgpu/sdma_5_2_6.bin amdgpu/vcn_3_1_2.bin amdgpu/dcn_3_1_6_dmcub.bin amdgpu/dcn_3_1_5_dmcub.bin"
CONFIG_EXTRA_FIRMWARE_DIR="@X86_ROOT@/firmware"

# --- GSC transport ---------------------------------------------------------
#
# mtl_gsc_1.bin above is only the blob. Talking to the GSC needs the MEI
# transport as well, and without it i915 says so at every boot:
#
#     i915 0000:00:02.0: [drm] GT1: can't init GSC proxy due to missing mei
#                        component
#     i915 0000:00:02.0: [drm] *ERROR* GT1: GSC proxy handler failed to init
#
# INTEL_MEI and INTEL_MEI_ME were already set; the GSC-specific halves were
# not, so the component i915 looks for never registered and the firmware this
# fragment already ships went unused. With them:
#
#     mei_gsc_proxy ...: bound 0000:00:02.0 (ops i915_gsc_proxy_component_ops)
#     GT1: Loaded GSC firmware i915/mtl_gsc_1.bin (cv1.0, r102.1.15.1926)
#     GT1: HuC: authenticated for all workloads
#
# That last line is the real gain: HuC authentication goes through the GSC, and
# it previously reached only "authenticated for clear media", so hardware media
# acceleration was half-enabled.
#
# It does NOT change GPU clocks, which is what it was tried for. Measured on
# SuperTuxKart/Candela City before and after, 60 samples each: peak 450 MHz,
# mean ~405 MHz, 18% of the 2250 MHz ceiling, identical either way. The
# apparent gap between punit_req_freq_mhz (2250) and rps_act_freq_mhz (400) is
# not throttling -- GuC SLPC owns the frequency here ("GUC: SLPC enabled"), so
# those sysfs values are the permitted ceiling rather than live demand. The GPU
# sits at 400 MHz because that is all this workload asks of it.
#
# PXP is enabled alongside because MEI_PXP is the other consumer of the same
# transport and costs nothing here.
CONFIG_INTEL_MEI_GSC=y
CONFIG_INTEL_MEI_GSC_PROXY=y
CONFIG_INTEL_MEI_PXP=y
CONFIG_DRM_I915_PXP=y


# --- Camera: V4L2 + UVC ----------------------------------------------------
# The external camera HAL enumerates /dev/video*, and without MEDIA_SUPPORT
# there is no V4L2 core at all -- so no /dev/video* node can ever appear, with
# or without a webcam plugged in. On real hardware that shows up as the Camera
# app crashing rather than saying "no camera":
#     FATAL EXCEPTION: main  (com.android.camera2)
#     java.lang.ArrayIndexOutOfBoundsException: length=0; index=0
#         at com.android.camera.app.CameraController.getCharacteristics
# Camera2 asks for camera[0] against an empty list. The HAL itself was already
# correct -- "external webcam service is starting" and cameraserver connects to
# it -- it simply had nothing to enumerate.
#
# UVC covers essentially every USB webcam and every laptop's built-in camera,
# which on a PC is a USB device internally. No firmware blob is needed.
CONFIG_MEDIA_SUPPORT=y
CONFIG_MEDIA_SUPPORT_FILTER=y
CONFIG_MEDIA_CAMERA_SUPPORT=y
CONFIG_MEDIA_USB_SUPPORT=y
CONFIG_VIDEO_DEV=y
CONFIG_USB_VIDEO_CLASS=y
CONFIG_USB_VIDEO_CLASS_INPUT_EVDEV=y
CONFIG_V4L2_MEM2MEM_DEV=y
CONFIG_VIDEOBUF2_V4L2=y

# --- Ethernet: Intel I225/I226 ---------------------------------------------
# e1000e and r8169 are already on, and the bring-up machine still came up with
# no eth0 at all -- only lo, dummy0 and tunnels. Recent Intel desktop/laptop
# boards use I225/I226, which is igc, a separate driver from e1000e.
CONFIG_IGC=y
CONFIG_IGB=y

# --- Touchpad --------------------------------------------------------------
# The bring-up laptop came up with a working built-in keyboard ("AT Translated
# Set 2 keyboard") and a USB mouse, and NO touchpad of any kind in the input
# list. i2c-hid was already enabled; what was missing is the I2C controller it
# sits on. On Intel laptops that is the Synopsys DesignWare block, and without
# I2C_DESIGNWARE_CORE the bus never appears, so i2c-hid has nothing to attach
# to and the touchpad is invisible rather than broken.
# COMMON_CLK first: I2C_DESIGNWARE_PLATFORM is
#     depends on (ACPI && COMMON_CLK) || !ACPI
# so with ACPI on and COMMON_CLK off the option is not even offered -- it
# silently vanishes from .config rather than failing, which is how the first
# attempt at this shipped a kernel that still had no touchpad.
CONFIG_COMMON_CLK=y

# The Intel LPSS bridge is what actually exposes those I2C controllers on a
# laptop; the DesignWare driver binds to what LPSS enumerates.
CONFIG_MFD_INTEL_LPSS=y
CONFIG_MFD_INTEL_LPSS_ACPI=y
CONFIG_MFD_INTEL_LPSS_PCI=y

CONFIG_I2C_DESIGNWARE_CORE=y
CONFIG_I2C_DESIGNWARE_PLATFORM=y

# Touchpads report as HID multitouch devices; without this they enumerate as a
# plain mouse at best.
CONFIG_HID_MULTITOUCH=y

# The PS/2 fallback for laptops that still use it. Synaptics and ALPS were
# already on; Elantech is common and was not.
CONFIG_MOUSE_PS2_ELANTECH=y
CONFIG_MOUSE_PS2_ELANTECH_SMBUS=y
CONFIG_MOUSE_ELAN_I2C=y
CONFIG_MOUSE_ELAN_I2C_I2C=y
CONFIG_MOUSE_ELAN_I2C_SMBUS=y

# --- WiFi: Intel (iwlwifi) -------------------------------------------------
# cfg80211/mac80211 were already on with no device driver behind them, so the
# bring-up laptop booted with no wlan interface at all -- only lo, dummy0 and
# tunnels. This is an Intel laptop, so iwlwifi covers it.
#
# Both operating-mode modules are needed: mvm drives everything from 7260
# onwards (AC 9560, AX200/201/210/211, BE200), dvm the older 4965/5000/6000
# parts. Firmware comes from /vendor/firmware -- see tools/fetch-firmware.sh --
# not CONFIG_EXTRA_FIRMWARE, because the right blob depends on the exact chip
# and linking 249 MB into the kernel to cover them all is absurd.
CONFIG_WIRELESS=y
CONFIG_IWLWIFI=y
CONFIG_IWLMVM=y
CONFIG_IWLDVM=y
# CONFIG_IWLWIFI_OPMODE_MODULAR is deliberately NOT set here. It is a promptless
# bool (iwlwifi/Kconfig:95-100) whose value is recomputed from
# "default y if IWLDVM=m / IWLMVM=m / IWLMLD=m", so a fragment cannot set it --
# with everything =y it evaluates to n and never appears in .config at all.
# Setting it only made a later reader think opmode dispatch was handled.

# --- Bluetooth: Intel over USB ---------------------------------------------
# CONFIG_BT was off entirely, so there was no Bluetooth subsystem to fail.
# btusb plus btintel covers every Intel combo card; the profiles below are what
# Android's stack actually binds to.
CONFIG_BT=y
CONFIG_BT_BREDR=y
CONFIG_BT_LE=y
CONFIG_BT_RFCOMM=y
CONFIG_BT_RFCOMM_TTY=y
CONFIG_BT_BNEP=y
CONFIG_BT_HIDP=y
CONFIG_BT_HCIBTUSB=y
CONFIG_BT_HCIBTUSB_BCM=y
CONFIG_BT_INTEL=y

# --- Firmware loading: let userspace serve it ------------------------------
# Built-in drivers probe during kernel init, long before first_stage_mount
# brings up /vendor. With only the direct filesystem loader, a driver that
# needs firmware at probe finds nothing and never binds -- and it looks
# identical to an unsupported device:
#     0000:00:14.3  8086:7e40  class=028000  driver=
# That is the laptop's Intel wifi. iwlwifi claims 0x7E40 and the blobs were on
# /vendor; the driver simply asked before /vendor existed.
#
# FW_LOADER_USER_HELPER makes the kernel fall back to a uevent that ueventd
# answers from /vendor/firmware once it is running. iwlwifi asks with
# request_firmware_nowait (iwl-drv.c), so the probe is already asynchronous and
# completes whenever the firmware arrives. Intel Bluetooth loads its ibt blobs
# the same way.
#
# The alternative -- linking blobs in with CONFIG_EXTRA_FIRMWARE, as the i915
# ones are -- does not scale here: 15 MB of iwlwifi across RF variants, when
# only one is needed and which one is not knowable at build time.
CONFIG_FW_LOADER_USER_HELPER=y
CONFIG_FW_LOADER_USER_HELPER_FALLBACK=y

# Read firmware straight out of its .zst, so the whole linux-firmware GPU corpus
# ships compressed (202 MB of nvidia rather than ~280 MB expanded).
# firmware_loader/main.c tries the bare name, then "<name>.zst", then "<name>.xz"
# (873/881/886), so nothing on the driver side has to know.
CONFIG_FW_LOADER_COMPRESS=y
CONFIG_FW_LOADER_COMPRESS_ZSTD=y
CONFIG_FW_LOADER_COMPRESS_XZ=y

# --- GPIO / pinctrl: the touchpad's interrupt -------------------------------
# The bring-up laptop's touchpad is SYNA311A on I2C. The driver finds it and
# the probe fails for want of an interrupt:
#     i2c_hid_acpi i2c-SYNA311A:00: HID over i2c has not been provided an Int IRQ
#     i2c_hid_acpi i2c-SYNA311A:00: probe with driver i2c_hid_acpi failed with error -22
# ACPI describes that interrupt as a GpioInt, which only the SoC's pinctrl/GPIO
# driver can resolve -- and CONFIG_GPIOLIB and CONFIG_PINCTRL were both off, so
# there was nothing to resolve it with. The device enumerates, the driver
# matches, and it still cannot work.
#
# This is why the kernel log mattered: from Android the touchpad was simply
# absent, which looks identical to a missing driver, and three earlier guesses
# (i2c-hid, HID multitouch, a USB Synaptics device that turned out to be the
# fingerprint reader) were all wrong.
CONFIG_GPIOLIB=y
CONFIG_GPIO_ACPI=y
CONFIG_PINCTRL=y
CONFIG_PINCTRL_INTEL=y

# Meteor Lake is this machine (Core Ultra 7 155H). The rest are the other Intel
# generations a generic PC image may meet -- each is small, and a missing one
# means a dead touchpad with no obvious cause.
CONFIG_PINCTRL_METEORLAKE=y
CONFIG_PINCTRL_ALDERLAKE=y
CONFIG_PINCTRL_TIGERLAKE=y
CONFIG_PINCTRL_ICELAKE=y
CONFIG_PINCTRL_CANNONLAKE=y
CONFIG_PINCTRL_SUNRISEPOINT=y
CONFIG_PINCTRL_GEMINILAKE=y
CONFIG_PINCTRL_JASPERLAKE=y
CONFIG_PINCTRL_ELKHARTLAKE=y
CONFIG_PINCTRL_LAKEFIELD=y
CONFIG_PINCTRL_BROXTON=y
CONFIG_PINCTRL_DENVERTON=y
CONFIG_PINCTRL_EMMITSBURG=y
CONFIG_PINCTRL_LEWISBURG=y
CONFIG_PINCTRL_INTEL_PLATFORM=y
CONFIG_PINCTRL_BAYTRAIL=y
CONFIG_PINCTRL_CHERRYVIEW=y

# virtio-gpu, for the QEMU development loop in doc/02-host-setup.md
CONFIG_DRM_VIRTIO_GPU=y


# dma-buf heaps -- minigbm's HAS_DMABUF_SYSTEM_HEAP path
CONFIG_DMABUF_HEAPS=y
CONFIG_DMABUF_HEAPS_SYSTEM=y

# --- Input: real PC hardware -----------------------------------------------
# NOTE: there is no CONFIG_I2C_HID in 7.2; it is I2C_HID_CORE + I2C_HID_ACPI.
# Without I2C_HID_ACPI modern laptop touchpads do not enumerate.
CONFIG_INPUT_EVDEV=y
CONFIG_HID_GENERIC=y
CONFIG_USB_HID=y
CONFIG_I2C_HID_CORE=y
CONFIG_I2C_HID_ACPI=y
CONFIG_KEYBOARD_ATKBD=y
CONFIG_MOUSE_PS2=y
CONFIG_UHID=y
CONFIG_HIDRAW=y

# --- Audio -----------------------------------------------------------------
# snd_hda_intel covers essentially all Intel and AMD PC audio.
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_HDA_INTEL=y
CONFIG_SND_SOC=y

# --- Storage ---------------------------------------------------------------
CONFIG_BLK_DEV_NVME=y
CONFIG_ATA=y
CONFIG_SATA_AHCI=y

# Booting from a USB stick needs the whole USB storage path built in, not as
# modules -- the root filesystem lives on it, so nothing can be loaded later.
# USB mass storage presents as SCSI, which is also why androidboot.boot_part_uuid
# resolves correctly there: init's boot-device lookup tries MMC / NVMe / SCSI
# matchers, and usb-storage lands in the SCSI one.
#
# UAS (USB Attached SCSI) is what most USB 3.0 sticks and enclosures actually
# speak; without it they fall back to the older bulk-only transport, which is
# slower and not supported by every device.
CONFIG_USB_STORAGE=y
CONFIG_USB_UAS=y

# --- USB gadget (USB adb; this machine has no device-mode controller) ------
#
# The framework only. There is no USB Device Controller on this hardware, so
# nothing can bind a gadget and USB adb is not achievable here; these are kept
# because they cost nothing and the image is meant to run on other machines.
#
# This was investigated properly and the answer is in the PCI class codes:
#
#     00:0d.0 [8086:7ec0] class 0c0330   xHCI host
#     00:0d.2 [8086:7ec2] class 0c0340   USB4 host interface
#     00:0d.3 [8086:7ec3] class 0c0340   USB4 host interface
#     00:14.0 [8086:7e7d] class 0c0330   xHCI host
#
# Under class 0c03 the prog-if byte is the whole question: 30 is xHCI, 40 is
# the USB4 host interface, and a USB *device* controller is fe. Every USB
# function on this machine is a host. 0c0340 was briefly misread as device
# mode, dwc3 was pointed at 00:0d.2 on the strength of it, and the kernel gave
# the flat contradiction:
#
#     dwc3 dwc3.0.auto: this is not a DesignWare USB3 DRD Core
#
# dwc3 had matched, mapped the registers, found no Synopsys ID and refused. The
# driver worked; the premise did not. DWC3, role switching and UCSI were all
# added for that attempt and are removed again with it, since a controller that
# does not exist needs no driver and dwc3 binding the USB4 interface is an
# error every boot rather than a harmless no-op.
#
# For debugging, use adb over the network. It needs both machines on one
# subnet, which is the only reason the earlier attempt failed.
CONFIG_USB=y
CONFIG_USB_SUPPORT=y
CONFIG_USB_GADGET=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_F_FS=y

# --- Power / ACPI ----------------------------------------------------------
CONFIG_SUSPEND=y
CONFIG_PM_WAKELOCKS=y
CONFIG_ACPI=y
CONFIG_ACPI_BUTTON=y
CONFIG_ACPI_BATTERY=y
CONFIG_ACPI_AC=y
CONFIG_CPU_FREQ=y
CONFIG_CPU_FREQ_STAT=y
CONFIG_RTC_CLASS=y

# --- Networking gates ------------------------------------------------------
# x86_64_defconfig leaves NETFILTER_ADVANCED off, which hides ~104 symbols
# across net/netfilter, net/ipv4/netfilter and net/ipv6/netfilter -- including
# most of the NETFILTER_XT_* and NF_CONNTRACK_* helpers that
# android-base.config requires for netd. Without this, merge_config sets them
# and olddefconfig silently drops them again on unmet dependencies.
CONFIG_NETFILTER_ADVANCED=y

# After 6.12 the legacy iptables/arptables tables were moved behind new
# *_LEGACY gates. android-base.config (6.12) predates the split, so every
# IP_NF_*/IP6_NF_* table it asks for is dropped on unmet dependencies unless
# these are set. netd still uses the legacy interface.
CONFIG_NETFILTER_XTABLES_LEGACY=y
CONFIG_IP_NF_IPTABLES_LEGACY=y
CONFIG_IP6_NF_IPTABLES_LEGACY=y

# INET_DIAG gates INET_DIAG_DESTROY / INET_UDP_DIAG, which Android uses to
# tear down sockets on network changes and VPN teardown.
CONFIG_INET_DIAG=y

# IFB depends on NET_ACT_MIRRED || NFT_FWD_NETDEV; Android's traffic shaping
# uses the mirred path.
CONFIG_NET_ACT_MIRRED=y

# HID_PLAYSTATION (required by android-base.config) depends on this.
CONFIG_LEDS_CLASS_MULTICOLOR=y

# --- Networking: virtio-net and e1000e for the QEMU dev VM -----------------
CONFIG_VIRTIO_NET=y
CONFIG_E1000E=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_CONSOLE=y

# --- Debugging: serial console is not optional for bring-up ----------------
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_MAGIC_SYSRQ=y
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y

# --- Audio: SOF (Sound Open Firmware) --------------------------------------
# The HDA controller binds but finds nothing on the link:
#     snd_hda_intel 0000:00:1f.3: Cannot probe codecs, giving up
#     ALSA device list:   No soundcards found.
#
# That is not a missing codec driver -- it is the wrong stack entirely. This is
# a Meteor Lake machine (GPU 8086:7dd5, audio 8086:7e28), where the codec sits
# behind the audio DSP rather than on the legacy HDA link, so legacy probing
# has nothing to find no matter which SND_HDA_CODEC_* are built. The DSP has to
# be driven by SOF, which loads firmware into it and then enumerates the codec.
#
# Android's side is already in place -- the AIDL audio HAL starts and registers
# IModule/default -- so this is purely kernel plus firmware.
CONFIG_SPI=y

CONFIG_SOUNDWIRE=y
CONFIG_SOUNDWIRE_INTEL=y

CONFIG_SND_SOC_SOF_TOPLEVEL=y
CONFIG_SND_SOC_SOF_PCI=y
CONFIG_SND_SOC_SOF_INTEL_TOPLEVEL=y
CONFIG_SND_SOC_SOF_METEORLAKE=y
CONFIG_SND_SOC_SOF_INTEL_SOUNDWIRE=y
# HDA_LINK gates HDA_AUDIO_CODEC, and it is a plain bool defaulting to n --
# setting only HDA_AUDIO_CODEC silently dropped it from .config on the first
# build. It carries the HDA and HDMI links under SOF, so without it there is no
# display audio and no analog codec on the HDA link; the SoundWire path would
# still have worked, which is exactly what would have made this hard to spot.
CONFIG_SND_SOC_SOF_HDA_LINK=y
CONFIG_SND_SOC_SOF_HDA_AUDIO_CODEC=y

# Which codec this laptop actually has is not knowable from here -- it is
# reported by ACPI at runtime, and the machine was not introspectable while
# powered down. SND_SOC_INTEL_SOUNDWIRE_SOF_MACH resolves that: it is the
# generic SoundWire machine driver and it 'select's essentially every codec a
# Meteor Lake laptop might carry (rt711/rt712/rt715/rt721/rt722, cs42l43 with
# its MFD, cs35l56, max98373, DMIC and more), letting the right one match by
# ACPI at boot. That is why the codecs are not listed individually below.
#
# Its four dependencies are all satisfied: I2C and ACPI were already on,
# MFD_INTEL_LPSS came in with the touchpad work, SOUNDWIRE is enabled just
# above, and SPI -- which was NOT set -- is enabled above too. Miss any one and
# the option does not error, it silently vanishes from .config, exactly as
# I2C_DESIGNWARE_PLATFORM did when COMMON_CLK was off.
CONFIG_SND_SOC_INTEL_MACH=y
CONFIG_SND_SOC_INTEL_USER_FRIENDLY_LONG_NAMES=y
CONFIG_SND_SOC_INTEL_HDA_DSP_COMMON=y
CONFIG_SND_SOC_INTEL_SOUNDWIRE_SOF_MACH=y

# The HDA generic machine driver -- the one this machine actually needs, and
# the piece missing from the first attempt. SOF got all the way to
#     hda codecs found, mask 5
#     using HDA machine driver skl_hda_dsp_generic now
#     Booted firmware version: 2.14.1.1
# and then went silent with no card: SOF creates the platform device for that
# machine driver, but nothing was built to bind it. The SoundWire machine
# driver above cannot serve it -- this codec is on the HDA link, not SoundWire,
# which is exactly what "hda codecs found" was reporting. Its only dependency,
# SND_HDA_CODEC_HDMI, is already set above.
CONFIG_SND_SOC_INTEL_SKL_HDA_DSP_GENERIC_MACH=y

# Legacy HDA codecs as well, for the case where the analog codec really is on
# the HDA link behind the DSP, and for display audio over HDMI/DP.
CONFIG_SND_HDA_GENERIC=y
CONFIG_SND_HDA_CODEC_REALTEK=y
CONFIG_SND_HDA_CODEC_HDMI=y

# --- Audio: HDA side-codec smart amplifiers --------------------------------
# The playback path is fully working at this point: the PCM opens, Android
# writes into it (827392 frames in one run, status 0, no xruns) and the mixer is
# wide open. Nothing comes out of the speakers, and the codec log says why:
#
#     snd_hda_codec_alc269: ALC245: picked fixup  for codec SSID 103c:8c48
#     autoconfig for ALC245: line_outs=1 (0x17) type:speaker
#                            speaker_outs=0
#                            hp_outs=1 (0x21)
#
# speaker_outs=0 -- the autoparser found no speaker pin on the codec at all,
# and the fixup name in that first line is empty, meaning no machine-specific
# quirk matched this SSID. That is the normal shape of a recent HP laptop: the
# ALC245 handles headphones and the microphone, while the internal speakers
# hang off separate Cirrus smart amplifiers on I2C or SPI, driven as HD-audio
# "side codecs". SND_HDA_SCODEC_COMPONENT (the framework) was already on, but
# not one actual amplifier driver was built, so there was nothing to bind.
#
# Both CS35L41 and CS35L56 are enabled, and both bus variants of each, because
# which amplifier and which bus this machine uses is described by ACPI and is
# not knowable from here -- the same reason all 189 SOF topologies are shipped.
# Only the matching driver binds; the rest cost image size and nothing else.
#
# Dependencies were checked rather than assumed: CS35L41 needs EFI (it reads
# its calibration from an EFI variable), both need ACPI and SND_SOC, and the
# bus variants need I2C or SPI_MASTER -- SPI arrived with the SOF work above.
# All were already satisfied.
CONFIG_SND_HDA_SCODEC_CS35L41_I2C=y
CONFIG_SND_HDA_SCODEC_CS35L41_SPI=y
CONFIG_SND_HDA_SCODEC_CS35L56_I2C=y
CONFIG_SND_HDA_SCODEC_CS35L56_SPI=y

# Not optional, despite only being 'imply'd by the drivers above. These amps
# are listed as several devices inside a single ACPI firmware node (typically
# CSC3551), and this driver is what instantiates a separate I2C/SPI client for
# each one. Without it the ACPI node is never expanded, no amplifier device is
# created, and the side-codec drivers have nothing to attach to -- which would
# look exactly like the drivers not working.
CONFIG_SERIAL_MULTI_INSTANTIATE=y

# The Intel LPSS SPI controller the speaker amplifiers sit on.
#
# Enabling the CS35L41 drivers above was necessary but not sufficient. The ACPI
# node is there and serial-multi-instantiate found it, but there was no SPI bus
# for it to put the amplifiers on:
#
#     platform CSC3551:00: deferred probe pending: Serial bus multi instantiate
#         pseudo device driver: failed to allocate SPI device CSC3551:00 from ACPI
#
# That line is worth reading closely, because it answers two questions at once.
# CSC3551 exists, so the internal speakers really are behind Cirrus amps rather
# than on the codec's own outputs -- and they are on SPI, not I2C, which the
# earlier config could not have known.
#
# CONFIG_SPI=y was added with the SOF work, but that is only the SPI core.
# CONFIG_SPI_MASTER and CONFIG_SPI_DYNAMIC were the only SPI symbols set: not
# one controller driver was built, so there was no spi_master to register a
# device against. SPI_PXA2XX is the driver for Intel LPSS SSP ports, which is
# what MFD_INTEL_LPSS (already enabled, for the I2C touchpad) exposes them as.
# SPI_PXA2XX_PCI follows automatically from PCI && COMMON_CLK, both already on.
CONFIG_SPI_PXA2XX=y


# =====================================================================
# Generic PC hardware -- WiFi, Bluetooth, input, storage, USB
# =====================================================================
# Everything above this line was shaped by the two machines this port was
# developed on: an Intel laptop and an AMD workstation. That is why WiFi was
# CONFIG_IWLWIFI and nothing else, and why the AMD workstation came up with no
# WiFi and no Bluetooth at all -- it has neither an Intel radio nor a Broadcom
# one, and no other vendor was built.
#
# This section is the distro answer: build every vendor a PC actually ships, the
# way Ubuntu's generic kernel does. Everything is =y because this image has no
# module loading (185 "=y" and zero "=m" above; there is no /lib/modules and no
# modprobe in the ramdisk).
#
# Every symbol below was checked against THIS tree (Linux 7.2.0-rc6) rather than
# from memory, because the names move: the fragment already carries a note that
# CONFIG_I2C_HID does not exist in 7.2 (it is I2C_HID_CORE + I2C_HID_ACPI), and
# the same trap caught IWLWIFI_OPMODE_MODULAR above.
#
# Two things are NOT here on purpose:
#   - No *_SDIO / *S wifi variants. SDIO radios are tablet/embedded parts.
#   - No B43/B43LEGACY and no RTL8XXXU_UNTESTED. b43's firmware is not in
#     linux-firmware at all (it needs b43-fwcutter against a Broadcom driver),
#     and RTL8XXXU_UNTESTED claims USB IDs that the maintained rtw88 USB drivers
#     also claim, so enabling it takes devices AWAY from a working driver.

# ---------------------------------------------------------------- WiFi ----
# cfg80211/mac80211/RFKILL and all 18 WLAN_VENDOR_* gates are already =y from
# x86_64_defconfig + android-base.config, so only the drivers are needed here.

# Intel. IWLWIFI was already on, but WiFi 7 silicon was NOT actually driven:
# iwl-drv.c:1906-1909 routes any device with device_family >= IWL_DEVICE_FAMILY_BZ
# and RF type >= FM to MLD_OP_MODE, and with CONFIG_IWLMLD unset that enum entry
# does not exist (iwl-drv.c:75-81) so those cards fall back to iwlmvm, which
# upstream no longer maintains for them. That is every BE200/BE201/BE202/BE211
# and the Killer BE1750/BE1790.
CONFIG_IWLMLD=y

# Realtek 802.11ax/be -- RTL8852BE is by volume the most common Wi-Fi 6 card in
# current AMD laptops, which is exactly the machine this was missing for.
CONFIG_RTW89=y
CONFIG_RTW89_8852AE=y
CONFIG_RTW89_8852BE=y
CONFIG_RTW89_8852BTE=y
CONFIG_RTW89_8852CE=y
CONFIG_RTW89_8851BE=y
CONFIG_RTW89_8922AE=y

# Realtek 802.11ac
CONFIG_RTW88=y
CONFIG_RTW88_8821CE=y
CONFIG_RTW88_8822BE=y
CONFIG_RTW88_8822CE=y
CONFIG_RTW88_8723DE=y

# Realtek legacy PCIe/USB. CONFIG_RTL_CARDS was ALREADY =y (its stanza is
# "default y") with every driver under it unset -- a grep for Realtek support
# hit, and built nothing. Same shape as the cfg80211-with-no-driver trap.
CONFIG_RTL_CARDS=y
CONFIG_RTL8821AE=y
CONFIG_RTL8723BE=y
CONFIG_RTL8188EE=y
CONFIG_RTL8192CE=y
CONFIG_RTL8XXXU=y

# MediaTek. MT7921 is sold as AMD's "RZ616" and MT7925 as "RZ717", so these are
# the radios in current AMD laptops.
CONFIG_MT7921E=y
CONFIG_MT7925E=y
CONFIG_MT7921U=y
CONFIG_MT7925U=y
CONFIG_MT7601U=y

# Qualcomm/Atheros. ath9k and ath5k need no firmware (EEPROM-based).
CONFIG_ATH9K=y
CONFIG_ATH9K_PCI=y
CONFIG_ATH9K_HTC=y
CONFIG_ATH10K=y
CONFIG_ATH10K_PCI=y
CONFIG_ATH11K=y
CONFIG_ATH11K_PCI=y
CONFIG_ATH12K=y

# Broadcom FullMAC -- Apple hardware and some Dell/HP.
CONFIG_BRCMFMAC=y
CONFIG_BRCMFMAC_PCIE=y

# ----------------------------------------------------------- Bluetooth ----
# The BT core was already on with BTUSB + BCM. Every other vendor was missing,
# and on a combo card the BT half is the same silicon as the WiFi half -- so a
# machine with Realtek or MediaTek WiFi had no Bluetooth either.
CONFIG_BT_RTL=y
CONFIG_BT_HCIBTUSB_RTL=y
CONFIG_BT_MTK=y
CONFIG_BT_HCIBTUSB_MTK=y
CONFIG_BT_QCA=y
CONFIG_BT_INTEL_PCIE=y
CONFIG_BT_ATH3K=y
# Vendor HCI extensions. AOSPEXT is what Android's own BT stack expects.
CONFIG_BT_MSFTEXT=y
CONFIG_BT_AOSPEXT=y
# UART-attached BT (x86 tablets/convertibles) needs serdev underneath it.
CONFIG_SERIAL_DEV_BUS=y
CONFIG_SERIAL_DEV_CTRL_TTYPORT=y
CONFIG_BT_HCIUART=y
CONFIG_BT_HCIUART_H4=y
CONFIG_BT_HCIUART_3WIRE=y
CONFIG_BT_HCIUART_INTEL=y
CONFIG_BT_HCIUART_BCM=y
CONFIG_BT_HCIUART_RTL=y
CONFIG_BT_HCIUART_QCA=y

# -------------------------------------------------- touchpad / keyboard ----
# Synaptics RMI4: the touchpad protocol on most ThinkPads and Dells. Without the
# F-function modules the bus binds and reports nothing usable.
CONFIG_RMI4_CORE=y
CONFIG_RMI4_I2C=y
CONFIG_RMI4_SMB=y
CONFIG_RMI4_F03=y
CONFIG_RMI4_F11=y
CONFIG_RMI4_F12=y
CONFIG_RMI4_F30=y
CONFIG_RMI4_F3A=y

# Per-vendor HID quirks. HID_GENERIC covers compliant devices; these are the
# ones that need a driver to report correctly at all.
CONFIG_HID_ASUS=y
CONFIG_HID_LENOVO=y
CONFIG_HID_ITE=y
CONFIG_HID_ELAN=y
CONFIG_HID_ALPS=y
CONFIG_HID_APPLE=y
CONFIG_HID_CHERRY=y
CONFIG_HID_MICROSOFT=y
CONFIG_HID_LOGITECH=y
CONFIG_HID_LOGITECH_DJ=y
CONFIG_HID_LOGITECH_HIDPP=y
CONFIG_HID_BATTERY_STRENGTH=y
CONFIG_INPUT_UINPUT=y
CONFIG_SERIO_RAW=y

# I2C touchscreens on convertibles/2-in-1s.
CONFIG_TOUCHSCREEN_ELAN=y
CONFIG_TOUCHSCREEN_GOODIX=y
CONFIG_TOUCHSCREEN_ILITEK=y
CONFIG_TOUCHSCREEN_USB_COMPOSITE=y

# Laptop platform drivers: Fn keys, rfkill (the WiFi/BT kill switch -- without
# this the radio can be blocked in hardware and look like a missing driver),
# backlight, lid and tablet-mode switches.
# The two X86_PLATFORM_DRIVERS_* are hidden menuconfig gates: without them every
# symbol underneath is silently dropped.
CONFIG_X86_PLATFORM_DRIVERS_DELL=y
CONFIG_DCDBAS=y
CONFIG_DELL_SMBIOS=y
CONFIG_DELL_LAPTOP=y
CONFIG_DELL_WMI=y
CONFIG_X86_PLATFORM_DRIVERS_HP=y
CONFIG_HP_WMI=y
CONFIG_ASUS_WMI=y
CONFIG_ASUS_NB_WMI=y
CONFIG_THINKPAD_ACPI=y
CONFIG_IDEAPAD_LAPTOP=y
CONFIG_ACER_WMI=y
CONFIG_INTEL_HID_EVENT=y
CONFIG_INTEL_VBTN=y
# s2idle on Ryzen laptops.
CONFIG_AMD_PMC=y

# ------------------------------------------ AMD laptop touchpad / GPIO ----
# The touchpad did not exist on the AMD laptop: /sys/bus/hid/devices held only
# the USB mouse, and every /sys/bus/i2c/devices entry was an "AMDGPU DM aux hw
# bus" -- i.e. display DDC channels, not a host controller with the touchpad on
# it.
#
# I2C_DESIGNWARE_PLATFORM was already =y, so the controller driver was there.
# The missing piece is PINCTRL_AMD: on an AMD laptop the I2C-HID touchpad's
# INTERRUPT is an ACPI GpioInt routed through the AMD GPIO controller. With no
# pinctrl driver that resource cannot be resolved, so i2c_hid_acpi never probes,
# no i2c client device is created, and no HID device appears. The touchpad is
# not "unsupported" -- it is never enumerated, which looks identical.
CONFIG_PINCTRL_AMD=y

# The other AMD I2C controller. Some Ryzen laptops put the touchpad behind MP2
# rather than the designware block, and which one a board uses is not knowable
# from here.
CONFIG_I2C_AMD_MP2=y
CONFIG_I2C_DESIGNWARE_PCI=y

# AMD PSP arbitration for an I2C bus shared with firmware; without it the shared
# bus can wedge on some Ryzen platforms.
CONFIG_I2C_DESIGNWARE_AMDPSP=y

# AMD/ATI SMBus. Also load-bearing for CONFIG_RMI4_SMB enabled above: RMI4 over
# SMBus is how many Synaptics touchpads attach, and it needs an SMBus host
# controller to attach TO.
CONFIG_I2C_PIIX4=y

# ------------------------------------------------- storage / SD / USB-C ----
# The whole MMC subsystem was off, so SD card readers did not exist. (No SDIO
# WiFi is enabled above, so turning MMC on adds card readers and nothing else.)
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_SDHCI=y
CONFIG_MMC_SDHCI_PCI=y
CONFIG_MMC_SDHCI_ACPI=y
CONFIG_MMC_CRYPTO=y
CONFIG_MISC_RTSX_PCI=y
CONFIG_MMC_REALTEK_PCI=y
CONFIG_MISC_RTSX_USB=y
CONFIG_MMC_REALTEK_USB=y
# Intel VMD: on many Dell/HP/Lenovo machines the NVMe is behind it and the disk
# is simply invisible without this.
CONFIG_VMD=y
CONFIG_ATA_GENERIC=y
CONFIG_HOTPLUG_PCI_PCIE=y
# USB-C / Thunderbolt: docks, DP-alt-mode displays, eGPU and TB storage.
CONFIG_USB4=y
CONFIG_TYPEC=y
CONFIG_TYPEC_UCSI=y
CONFIG_UCSI_ACPI=y
CONFIG_TYPEC_DP_ALTMODE=y
CONFIG_USB_ACM=y

# ------------------------------------------------------------ ethernet ----
# USB_USBNET was off, which disabled every USB ethernet adapter and phone
# tethering in one go.
CONFIG_USB_USBNET=y
CONFIG_USB_NET_AX8817X=y
CONFIG_USB_NET_AX88179_178A=y
CONFIG_USB_RTL8152=y
CONFIG_USB_LAN78XX=y
CONFIG_USB_NET_SMSC95XX=y
CONFIG_USB_NET_CDC_NCM=y
CONFIG_USB_NET_RNDIS_HOST=y
CONFIG_ALX=y
CONFIG_ATL1C=y
CONFIG_ATL1E=y
CONFIG_ATL1=y
