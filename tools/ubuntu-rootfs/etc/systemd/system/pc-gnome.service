# GNOME on the panel, for Ubuntu alongside Android (doc/10, step 3).
#
# Not gdm: gdm needs VTs, and this container has none (seat0 CanTTY=no). A
# PAM session from a system unit gets the same thing gdm would give it: a
# logind session on seat0, through pam_systemd, which reads XDG_SEAT and
# XDG_SESSION_TYPE from this environment. logind then sets DRM master for the
# active session and hands mutter its devices through TakeDevice.
#
# Started by hand (or by the seat broker), never at boot: Android must have
# released the screen first (setprop vendor.hwc.master ubuntu).
[Unit]
Description=GNOME session on seat0 for user amar
After=systemd-logind.service pc-udev-shim.service dbus.service systemd-user-sessions.service

[Service]
User=amar
PAMName=login
Environment=XDG_SESSION_TYPE=wayland XDG_SESSION_CLASS=user XDG_SEAT=seat0
Environment=XDG_SESSION_DESKTOP=ubuntu XDG_CURRENT_DESKTOP=ubuntu:GNOME DESKTOP_SESSION=ubuntu
ExecStart=/usr/bin/gnome-session --session=ubuntu
StandardOutput=journal
StandardError=journal
